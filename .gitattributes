# Large data artifacts tracked via Git LFS (forward-only — existing history
# is unchanged; these patterns apply to new/modified files from here on).
*.ttl     filter=lfs diff=lfs merge=lfs -text
*.nq.gz   filter=lfs diff=lfs merge=lfs -text
*.geojson filter=lfs diff=lfs merge=lfs -text
*.tar.gz  filter=lfs diff=lfs merge=lfs -text
# Inlined map data bundles (large; one per map)
demos/parliament-live/web/*/data.js filter=lfs diff=lfs merge=lfs -text
