# Environment variables for forgetmenot. Copy to `.env` (gitignored) and fill in
# for local use, OR set the same names as GitHub Actions secrets for CI.
# NEVER commit real values. NEVER paste secrets into chat or into URLs.

# legislation.gov.uk SPARQL endpoint — HTTP Basic auth (the public endpoint 401s).
# Used by lib/facilities/legislation.mjs (Authorization: Basic base64(user:pass)).
LEGISLATION_SPARQL_USER=your-username
LEGISLATION_SPARQL_PASSWORD=your-password

# Existing optional override the repo already reads:
# PSEPHOLOGY_URI=
