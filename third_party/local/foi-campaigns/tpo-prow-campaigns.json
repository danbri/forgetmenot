  "_meta": {
    "title": "WhatDoTheyKnow FOI campaigns: brute-force national aggregation of local geo-fenced orders",
    "what": "Two templated FOI campaigns where requesters rebuild a national dataset council-by-council because no central register exists: (1) Tree Preservation Orders 'Digital Format'; (2) Public Rights of Way 'GIS Data' / digitised Definitive Map.",
    "generated": "2026-06-29",
    "source_platform": "https://www.whatdotheyknow.com (mySociety Alaveteli)",
    "method": "Survey via web search index scoped to whatdotheyknow.com. WhatDoTheyKnow's native search/feeds/request pages and .json endpoints are behind a Cloudflare bot-challenge and could not be fetched directly, so authorities are taken from result-title convention ('<request> - a Freedom of Information request to <AUTHORITY> - WhatDoTheyKnow') and outcomes inferred from search snippets only.",
    "epistemic_key": {
      "sourced": "authority + request slug/URL (read verbatim from WhatDoTheyKnow result titles/URLs)",
      "interpreted": "the `outcome` label and `outcome_detail` (inferred from a search snippet, NOT read from the full request thread)"
    },
    "outcome_vocabulary": {
      "supplied": "council provided digital/GIS data (shapefile/GeoJSON/KML/CSV/spreadsheet)",
      "partial": "some data provided, incomplete or with caveats",
      "available_online": "council pointed to an existing web map / open-data page",
      "not_held_digital": "no digital/machine-readable form held (paper / scans / web-map-only)",
      "withheld_ip": "held but withheld citing third-party IP (usually Ordnance Survey / Crown copyright)",
      "in_progress": "council said a digital layer was being built",
      "unknown": "snippet did not state an outcome"
    },
    "limits": "Strict LOWER BOUND. TPO slugs observed up to _276 (=> on the order of ~270 councils sent the identical request) but the index surfaced only ~85; PROW similarly truncated. Requester identity and exact dates were not exposed in snippets; activity clusters around 2017. A curated WhatDoTheyKnow list exists at https://www.whatdotheyknow.com/list/TPOs (Cloudflare-blocked from direct fetch).",
    "review": { "status": "unreviewed", "note": "Outcomes are snippet-inferred and must be verified against each full request thread before any citation." }
  },

