# Endpoint: /kgx/query  (FPKG, bundled)
# Verified: 2026-05-29 against fpkg.fly.dev — returns rows.
#
# All-Party Parliamentary Groups with their subject category and purpose.
# The APPG register is scraped (no official JSON API) and lives in the
# transparency named graph. Officer roles are the t:officerOf /
# t:officerRoleIn edges on each officer node.
PREFIX t: <https://forgetmenot.example/transparency#>

SELECT ?title ?category ?purpose
WHERE {
  GRAPH <https://forgetmenot.example/transparency#graph/appg-register> {
    ?g a t:APPG ;
       t:title    ?title ;
       t:category ?category ;
       t:purpose  ?purpose .
  }
}
ORDER BY ?category ?title
LIMIT 200
