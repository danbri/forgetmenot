# Endpoint: https://query.wikidata.org/sparql  (Wikidata)
# Showcases the playground's WDQS-style result panel:
#   - SERVICE wikibase:label triggers the ?pm + ?pmLabel column merge
#     (label as the primary text, QID as a small linked badge)
#   - wdt:P18 binds an image URL → rendered inline as a 100 px thumbnail
#   - ?start dates sort chronologically when you tap the column header

PREFIX wd:  <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX p:   <http://www.wikidata.org/prop/>
PREFIX ps:  <http://www.wikidata.org/prop/statement/>
PREFIX pq:  <http://www.wikidata.org/prop/qualifier/>

SELECT ?pm ?pmLabel ?image ?start WHERE {
  ?pm p:P39 ?term .
  ?term ps:P39 wd:Q14211 ;            # position held: UK Prime Minister
        pq:P580 ?start .
  OPTIONAL { ?pm wdt:P18 ?image }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
ORDER BY DESC(?start)
LIMIT 30
