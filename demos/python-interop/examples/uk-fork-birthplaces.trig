@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Tree-shaped chain: shared main branch (source → Labour → 2024 onward),
# then a sibling 'with-bp' branch forks off bead 2 and pivots via wdt:P19
# to each MP's town of birth.

<urn:kgx:chain:uk-fork-birthplaces> {
  <urn:kgx:chain:uk-fork-birthplaces>
    dct:title       "UK Labour MPs (since 2024) → fork to birthplaces" ;
    dct:description "Shared prefix, then a sibling branch pivots to birthplaces via wdt:P19." ;
    kgx:activeBranch "with-bp" .

  <urn:kgx:chain:uk-fork-birthplaces:bead:0> a kgx:SourceBundle ;
    kgx:branch         "main" ;
    kgx:gloss          "UK Commons seats whose term started on or after 4 July 2024" ;
    kgx:starterId      "uk-mps-2024" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?seat . ?seat ps:P39 ?pos . ?pos wdt:P279* wd:Q16707842 . ?seat pq:P768 ?cons . ?cons wdt:P17 wd:Q145 . ?seat pq:P580 ?start . FILTER(?start >= \"2024-07-04T00:00:00\"^^xsd:dateTime) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:uk-fork-birthplaces:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-fork-birthplaces:bead:0> ;
    kgx:branch         "main" ;
    kgx:gloss          "Members of the Labour Party" ;
    kgx:propertyIri    wdt:P102 ;
    kgx:valueIri       wd:Q9630 ;
    kgx:sparqlFragment "?p wdt:P102 wd:Q9630 ." .

  <urn:kgx:chain:uk-fork-birthplaces:bead:2> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-fork-birthplaces:bead:1> ;
    kgx:branch         "main" ;
    kgx:gloss          "Sanity probe — wd:Q5 humans" ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q5 ." .

  <urn:kgx:chain:uk-fork-birthplaces:bead:with-bp:0> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:uk-fork-birthplaces:bead:2> ;
    kgx:branch         "with-bp" ;
    kgx:gloss          "Birthplaces — walk wdt:P19, keep towns / cities" ;
    kgx:produces       wd:Q486972 ;
    kgx:relTemplate    "birthplaces" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P19 ?place . ?place wdt:P31/wdt:P279* wd:Q486972 ." .
}

