@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Anyone who has held a Q48352 (head of state) position and was born on
# or after 1 January 1950. Positive age filter — no 'living' / NOT EXISTS.

<urn:kgx:chain:former-hos-1950> {
  <urn:kgx:chain:former-hos-1950>
    dct:title       "Heads of state born since 1950" ;
    dct:description "People who have held any head-of-state position, born on or after 1950-01-01. A recent generation of leaders." .

  <urn:kgx:chain:former-hos-1950:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Heads of state born on or after 1950-01-01" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P39 ?pos . ?pos wdt:P279* wd:Q48352 . ?p wdt:P569 ?dob . FILTER(?dob >= \"1950-01-01T00:00:00\"^^xsd:dateTime) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

