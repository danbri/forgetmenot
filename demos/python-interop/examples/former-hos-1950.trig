@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:former-hos-1950> {
  <urn:kgx:chain:former-hos-1950>
    dct:title       "Heads of state born since 1950 → countries → capitals" ;
    dct:description "Four atomic beads: humans → born ≥ 1950 → held a head-of-state position → pivot to country (P1001) → capital city." .

  <urn:kgx:chain:former-hos-1950:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All humans" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q5 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:former-hos-1950:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:former-hos-1950:bead:0> ;
    kgx:gloss          "Born on or after 1 January 1950" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P569 ?_dob . FILTER(?_dob >= \"1950-01-01T00:00:00\"^^xsd:dateTime)" .

  <urn:kgx:chain:former-hos-1950:bead:2> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:former-hos-1950:bead:1> ;
    kgx:gloss          "Holds a head-of-state class position" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P39 ?_pos . ?_pos wdt:P279* wd:Q48352 ." .

  <urn:kgx:chain:former-hos-1950:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:former-hos-1950:bead:2> ;
    kgx:gloss          "Walk wdt:P1001 to the country of the position" ;
    kgx:produces       wd:Q6256 ;
    kgx:relTemplate    "country" ;
    kgx:relVariant     "of_position" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_pos wdt:P1001 ?cty . OPTIONAL { ?cty rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?cty wdt:P18 ?image1 } BIND(?cty AS ?p1)" .

  <urn:kgx:chain:former-hos-1950:bead:4> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:former-hos-1950:bead:3> ;
    kgx:gloss          "Walk wdt:P36 to the capital of that country" ;
    kgx:produces       wd:Q5119 ;
    kgx:relTemplate    "capital" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?cty wdt:P36 ?cap . OPTIONAL { ?cap rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?cap wdt:P18 ?image2 } BIND(?cap AS ?p2)" .

}
