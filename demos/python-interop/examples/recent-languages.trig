@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Programming languages (Q9143) with inception (P571) on or after
# 2010-01-01. Positive temporal anchor.

<urn:kgx:chain:recent-languages> {
  <urn:kgx:chain:recent-languages>
    dct:title       "Programming languages first released since 2010" ;
    dct:description "wd:Q9143 (programming language) with inception ≥ 2010-01-01. Rust, Crystal, Zig, Carbon." .

  <urn:kgx:chain:recent-languages:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Programming languages with P571 ≥ 2010-01-01" ;
    kgx:produces       wd:Q9143 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31/wdt:P279* wd:Q9143 . ?p wdt:P571 ?inception . FILTER(?inception >= \"2010-01-01T00:00:00\"^^xsd:dateTime) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

