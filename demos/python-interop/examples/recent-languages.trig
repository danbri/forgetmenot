@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:recent-languages> {
  <urn:kgx:chain:recent-languages>
    dct:title       "Recent programming languages → their designers → universities → countries" ;
    dct:description "Two filters (language + inception ≥ 2010), then three pivots walking through designer → their alma mater → that uni's country." .

  <urn:kgx:chain:recent-languages:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All programming languages" ;
    kgx:produces       wd:Q9143 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31/wdt:P279* wd:Q9143 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:recent-languages:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:recent-languages:bead:0> ;
    kgx:gloss          "Inception (P571) on or after 2010-01-01" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P571 ?_t . FILTER(?_t >= \"2010-01-01T00:00:00\"^^xsd:dateTime)" .

  <urn:kgx:chain:recent-languages:bead:2> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:recent-languages:bead:1> ;
    kgx:gloss          "Walk wdt:P287 to the designer of the language" ;
    kgx:produces       wd:Q5 ;
    kgx:relTemplate    "designer" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P287 ?d . OPTIONAL { ?d rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?d wdt:P18 ?image1 } BIND(?d AS ?p1)" .

  <urn:kgx:chain:recent-languages:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:recent-languages:bead:2> ;
    kgx:gloss          "Walk wdt:P69 to where the designer studied" ;
    kgx:produces       wd:Q3918 ;
    kgx:relTemplate    "alma_maters" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?d wdt:P69 ?uni . OPTIONAL { ?uni rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?uni wdt:P18 ?image2 } BIND(?uni AS ?p2)" .

  <urn:kgx:chain:recent-languages:bead:4> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:recent-languages:bead:3> ;
    kgx:gloss          "Walk wdt:P17 to the country of the uni" ;
    kgx:produces       wd:Q6256 ;
    kgx:relTemplate    "country" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?uni wdt:P17 ?cty . OPTIONAL { ?cty rdfs:label ?label3 . FILTER(lang(?label3) = \"en\") } OPTIONAL { ?cty wdt:P18 ?image3 } BIND(?cty AS ?p3)" .

}
