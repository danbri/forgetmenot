@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Volcanoes (Q8072) in country Japan (Q17). Doesn't try to assert
# 'active' — that's a CWA judgement that depends on the data source.

<urn:kgx:chain:japan-volcanoes> {
  <urn:kgx:chain:japan-volcanoes>
    dct:title       "Volcanoes in Japan" ;
    dct:description "wd:Q8072 (volcano) located in country wd:Q17 (Japan). Mount Fuji and friends." .

  <urn:kgx:chain:japan-volcanoes:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Volcanoes (Q8072) located in country Japan (Q17)" ;
    kgx:produces       wd:Q8072 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31/wdt:P279* wd:Q8072 . ?p wdt:P17 wd:Q17 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

