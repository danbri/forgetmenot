@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Augment chain: seed from Wikidata, bridge to the UK Parliament DDP for
# the current constituency + party name, then back to Wikidata for DOB +
# birthplace + alma maters. Three different endpoints touched in one chain.

<urn:kgx:chain:uk-tory-enriched> {
  <urn:kgx:chain:uk-tory-enriched>
    dct:title       "Tory MP, enriched via DDP and Wikidata" ;
    dct:description "Seed → Conservative filter → parl-enrich (DDP) → Wikidata enrich. Every bead runnable." .

  <urn:kgx:chain:uk-tory-enriched:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "UK Commons seats whose term started on or after 4 July 2024" ;
    kgx:starterId      "uk-mps-2024" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?seat . ?seat ps:P39 ?pos . ?pos wdt:P279* wd:Q16707842 . ?seat pq:P768 ?cons . ?cons wdt:P17 wd:Q145 . ?seat pq:P580 ?start . FILTER(?start >= \"2024-07-04T00:00:00\"^^xsd:dateTime) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:uk-tory-enriched:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-tory-enriched:bead:0> ;
    kgx:gloss          "Members of the Conservative Party" ;
    kgx:op             "party" ;
    kgx:opValue        "Conservative" ;
    kgx:propertyIri    wdt:P102 ;
    kgx:valueIri       wd:Q9626 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P102 wd:Q9626 ." .

  <urn:kgx:chain:uk-tory-enriched:bead:2> a kgx:AugmentBundle ;
    kgx:input          <urn:kgx:chain:uk-tory-enriched:bead:1> ;
    kgx:gloss          "Bridge to Parliament DDP: current constituency + party via rdfs:seeAlso" ;
    kgx:op             "parl-enrich" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://api.parliament.uk/sparql> ] ;
    kgx:sparql """PREFIX schema: <https://id.parliament.uk/schema/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?qid (SAMPLE(?cgName) AS ?constituency) (SAMPLE(?partyName) AS ?party)
WHERE {
  VALUES ?qid { <http://www.wikidata.org/entity/Q193672> <http://www.wikidata.org/entity/Q333867> }
  ?personUri rdfs:seeAlso ?qid ;
             a schema:Member ;
             schema:memberHasParliamentaryIncumbency ?in .
  OPTIONAL { ?in schema:seatIncumbencyHasHouseSeat/schema:houseSeatHasConstituencyGroup/schema:constituencyGroupName ?cgName }
  OPTIONAL { ?personUri schema:partyMemberHasPartyMembership ?pm .
             ?pm schema:partyMembershipHasParty/schema:partyName ?partyName }
} GROUP BY ?qid""" .

  <urn:kgx:chain:uk-tory-enriched:bead:3> a kgx:AugmentBundle ;
    kgx:input          <urn:kgx:chain:uk-tory-enriched:bead:2> ;
    kgx:gloss          "Wikidata enrich: dates of birth + birthplaces + alma maters" ;
    kgx:op             "enrich" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparql """PREFIX wd:   <http://www.wikidata.org/entity/>
PREFIX wdt:  <http://www.wikidata.org/prop/direct/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?p ?dob (SAMPLE(?bpLbl) AS ?birthplace) (GROUP_CONCAT(DISTINCT ?amLbl; separator=" | ") AS ?almaMaters)
WHERE {
  VALUES ?p { wd:Q193672 wd:Q333867 }
  OPTIONAL { ?p wdt:P569 ?dob }
  OPTIONAL { ?p wdt:P19 ?bp . OPTIONAL { ?bp rdfs:label ?bpLbl . FILTER(lang(?bpLbl) = "en") } }
  OPTIONAL { ?p wdt:P69 ?am . OPTIONAL { ?am rdfs:label ?amLbl . FILTER(lang(?amLbl) = "en") } }
} GROUP BY ?p ?dob""" .
}

