@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:uk-reform-2024> {
  <urn:kgx:chain:uk-reform-2024>
    dct:title       "UK Reform MPs since 2024 → birthplaces → countries → continents" ;
    dct:description "Five atomic filters narrow to Reform MPs of the 2024 cohort, then pivot through birthplaces → countries → continents." .

  <urn:kgx:chain:uk-reform-2024:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All humans" ;
    kgx:starterId      "humans" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q5 . FILTER(STRSTARTS(STR(?p), \"http://www.wikidata.org/entity/Q\")) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:uk-reform-2024:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-reform-2024:bead:0> ;
    kgx:gloss          "Holds at least one P39 position" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?_seat . ?_seat ps:P39 ?_pos ." .

  <urn:kgx:chain:uk-reform-2024:bead:2> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-reform-2024:bead:1> ;
    kgx:gloss          "The held position derives from UK MP class (Q16707842)" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_pos wdt:P279* wd:Q16707842 ." .

  <urn:kgx:chain:uk-reform-2024:bead:3> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-reform-2024:bead:2> ;
    kgx:gloss          "The position's constituency qualifier is in a UK constituency" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_seat pq:P768 ?_cons . ?_cons wdt:P17 wd:Q145 ." .

  <urn:kgx:chain:uk-reform-2024:bead:4> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-reform-2024:bead:3> ;
    kgx:gloss          "Seat's term started on or after the 4 July 2024 GE" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_seat pq:P580 ?_t . FILTER(?_t >= \"2024-07-04T00:00:00\"^^xsd:dateTime)" .

  <urn:kgx:chain:uk-reform-2024:bead:5> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-reform-2024:bead:4> ;
    kgx:gloss          "Party = Reform UK (Q104721252)" ;
    kgx:propertyIri    wdt:P102 ;
    kgx:valueIri       wd:Q104721252 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P102 wd:Q104721252 ." .

  <urn:kgx:chain:uk-reform-2024:bead:6> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:uk-reform-2024:bead:5> ;
    kgx:gloss          "Walk wdt:P19 to each MP's birthplace" ;
    kgx:produces       wd:Q486972 ;
    kgx:relTemplate    "birthplaces" ;
    kgx:relVariant     "towns" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P19 ?bp . ?bp wdt:P31/wdt:P279* wd:Q486972 . OPTIONAL { ?bp rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?bp wdt:P18 ?image1 } BIND(?bp AS ?p1)" .

  <urn:kgx:chain:uk-reform-2024:bead:7> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:uk-reform-2024:bead:6> ;
    kgx:gloss          "Walk wdt:P17 to the country of the birthplace" ;
    kgx:produces       wd:Q6256 ;
    kgx:relTemplate    "country" ;
    kgx:relVariant     "of_birthplace" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?bp wdt:P17 ?cty . OPTIONAL { ?cty rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?cty wdt:P18 ?image2 } BIND(?cty AS ?p2)" .

  <urn:kgx:chain:uk-reform-2024:bead:8> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:uk-reform-2024:bead:7> ;
    kgx:gloss          "Walk wdt:P30 to the continent of the country" ;
    kgx:produces       wd:Q5107 ;
    kgx:relTemplate    "continent" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?cty wdt:P30 ?cn . OPTIONAL { ?cn rdfs:label ?label3 . FILTER(lang(?label3) = \"en\") } OPTIONAL { ?cn wdt:P18 ?image3 } BIND(?cn AS ?p3)" .

}
