@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Reform UK MPs whose Commons seat started on or after 4 July 2024.
# Reform got 5 seats at the 2024 GE, plus subsequent by-elections.

<urn:kgx:chain:uk-reform-2024> {
  <urn:kgx:chain:uk-reform-2024>
    dct:title       "UK Reform UK MPs elected since 4 July 2024" ;
    dct:description "Five-ish MPs including Nigel Farage himself. Tile grid shows the cohort at a glance." .

  <urn:kgx:chain:uk-reform-2024:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "UK Commons seats whose term started on or after 4 July 2024" ;
    kgx:starterId      "uk-mps-2024" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?seat . ?seat ps:P39 ?pos . ?pos wdt:P279* wd:Q16707842 . ?seat pq:P768 ?cons . ?cons wdt:P17 wd:Q145 . ?seat pq:P580 ?start . FILTER(?start >= \"2024-07-04T00:00:00\"^^xsd:dateTime) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:uk-reform-2024:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-reform-2024:bead:0> ;
    kgx:gloss          "Members of Reform UK (Q104721252)" ;
    kgx:propertyIri    wdt:P102 ;
    kgx:valueIri       wd:Q104721252 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P102 wd:Q104721252 ." .
}

