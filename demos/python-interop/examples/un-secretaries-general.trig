@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:un-secretaries-general> {
  <urn:kgx:chain:un-secretaries-general>
    dct:title       "UN Secretaries-General → countries → capitals → continents" ;
    dct:description "One filter bead (Q81066), then three pivots: country of citizenship → that country's capital → that country's continent." .

  <urn:kgx:chain:un-secretaries-general:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All humans" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q5 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:un-secretaries-general:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:un-secretaries-general:bead:0> ;
    kgx:gloss          "Holds Q81066 (UN Secretary-General)" ;
    kgx:propertyIri    wdt:P39 ;
    kgx:valueIri       wd:Q81066 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P39 wd:Q81066 ." .

  <urn:kgx:chain:un-secretaries-general:bead:2> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:un-secretaries-general:bead:1> ;
    kgx:gloss          "Walk wdt:P27 (country of citizenship) per SG" ;
    kgx:produces       wd:Q6256 ;
    kgx:relTemplate    "citizenship" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P27 ?cty . OPTIONAL { ?cty rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?cty wdt:P18 ?image1 } BIND(?cty AS ?p1)" .

  <urn:kgx:chain:un-secretaries-general:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:un-secretaries-general:bead:2> ;
    kgx:gloss          "Walk wdt:P36 to the capital of that country" ;
    kgx:produces       wd:Q5119 ;
    kgx:relTemplate    "capital" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?cty wdt:P36 ?cap . OPTIONAL { ?cap rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?cap wdt:P18 ?image2 } BIND(?cap AS ?p2)" .

  <urn:kgx:chain:un-secretaries-general:bead:4> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:un-secretaries-general:bead:3> ;
    kgx:gloss          "Walk wdt:P30 to the continent of the country" ;
    kgx:produces       wd:Q5107 ;
    kgx:relTemplate    "continent" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?cty wdt:P30 ?cn . OPTIONAL { ?cn rdfs:label ?label3 . FILTER(lang(?label3) = \"en\") } OPTIONAL { ?cn wdt:P18 ?image3 } BIND(?cn AS ?p3)" .

}
