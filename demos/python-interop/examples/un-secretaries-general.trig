@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Every holder of wd:Q81066 (Secretary-General of the United Nations) —
# ten people from Trygve Lie to António Guterres.

<urn:kgx:chain:un-secretaries-general> {
  <urn:kgx:chain:un-secretaries-general>
    dct:title       "UN Secretaries-General" ;
    dct:description "Every holder of wd:Q81066 — ten people from Trygve Lie to António Guterres." .

  <urn:kgx:chain:un-secretaries-general:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Holders of Q26197 (Secretary-General of the United Nations)" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P39 wd:Q81066 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

