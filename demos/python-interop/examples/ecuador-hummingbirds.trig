@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:ecuador-hummingbirds> {
  <urn:kgx:chain:ecuador-hummingbirds>
    dct:title       "Hummingbirds → endemic to Ecuador → their orders" ;
    dct:description "Two filter beads (parent ≤ family Trochilidae + endemic to Ecuador), then pivot up the taxonomic tree to the order." .

  <urn:kgx:chain:ecuador-hummingbirds:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All taxa in family Trochilidae lineage" ;
    kgx:produces       wd:Q16521 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P171*/wdt:P279* wd:Q25400 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:ecuador-hummingbirds:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:ecuador-hummingbirds:bead:0> ;
    kgx:gloss          "Endemic to Ecuador (Q736)" ;
    kgx:propertyIri    wdt:P183 ;
    kgx:valueIri       wd:Q736 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P183 wd:Q736 ." .

  <urn:kgx:chain:ecuador-hummingbirds:bead:2> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:ecuador-hummingbirds:bead:1> ;
    kgx:gloss          "Walk wdt:P171 transitively upward to the order" ;
    kgx:produces       wd:Q36602 ;
    kgx:relTemplate    "order" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P171+ ?ord . ?ord wdt:P105 wd:Q36602 . OPTIONAL { ?ord rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?ord wdt:P18 ?image1 } BIND(?ord AS ?p1)" .

}
