@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Members of family Trochilidae (Q25400 — hummingbird) whose endemic-to
# (P183) is Ecuador (Q736). One of Wikidata's better-covered taxonomic
# corners.

<urn:kgx:chain:ecuador-hummingbirds> {
  <urn:kgx:chain:ecuador-hummingbirds>
    dct:title       "Hummingbird species endemic to Ecuador" ;
    dct:description "Species of family Trochilidae whose endemic-to area is Ecuador." .

  <urn:kgx:chain:ecuador-hummingbirds:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Hummingbirds (P171 = Trochilidae) endemic to Ecuador" ;
    kgx:produces       wd:Q16521 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P171*/wdt:P279* wd:Q25400 . ?p wdt:P183 wd:Q736 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

