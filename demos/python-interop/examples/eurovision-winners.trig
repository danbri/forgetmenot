@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Winners (P1346) of Eurovision Song Contest editions (Q276 subclass).

<urn:kgx:chain:eurovision-winners> {
  <urn:kgx:chain:eurovision-winners>
    dct:title       "Eurovision Song Contest winners, by edition" ;
    dct:description "wd:Q276 (Eurovision Song Contest) → wdt:P1346 (winner) per edition." .

  <urn:kgx:chain:eurovision-winners:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Eurovision Song Contest edition → winning act" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?edition wdt:P31 wd:Q27968055 ; wdt:P1346 ?p . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

