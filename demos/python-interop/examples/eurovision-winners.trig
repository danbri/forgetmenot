@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:eurovision-winners> {
  <urn:kgx:chain:eurovision-winners>
    dct:title       "Eurovision winners → countries → capitals → continents" ;
    dct:description "One filter bead detects winning acts via P1346; three pivots walk to country, capital, and continent." .

  <urn:kgx:chain:eurovision-winners:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All Eurovision editions" ;
    kgx:produces       wd:Q27968055 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q27968055 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:eurovision-winners:bead:1> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:eurovision-winners:bead:0> ;
    kgx:gloss          "Walk wdt:P1346 to the winning act of each edition" ;
    kgx:produces       wd:Q5 ;
    kgx:relTemplate    "winner" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P1346 ?act . OPTIONAL { ?act rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?act wdt:P18 ?image1 } BIND(?act AS ?p1)" .

  <urn:kgx:chain:eurovision-winners:bead:2> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:eurovision-winners:bead:1> ;
    kgx:gloss          "Walk wdt:P495 to the act's country of origin" ;
    kgx:produces       wd:Q6256 ;
    kgx:relTemplate    "country" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?act wdt:P495 ?cty . OPTIONAL { ?cty rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?cty wdt:P18 ?image2 } BIND(?cty AS ?p2)" .

  <urn:kgx:chain:eurovision-winners:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:eurovision-winners:bead:2> ;
    kgx:gloss          "Walk wdt:P36 to the capital of that country" ;
    kgx:produces       wd:Q5119 ;
    kgx:relTemplate    "capital" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?cty wdt:P36 ?cap . OPTIONAL { ?cap rdfs:label ?label3 . FILTER(lang(?label3) = \"en\") } OPTIONAL { ?cap wdt:P18 ?image3 } BIND(?cap AS ?p3)" .

  <urn:kgx:chain:eurovision-winners:bead:4> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:eurovision-winners:bead:3> ;
    kgx:gloss          "Walk wdt:P30 to the continent of that country" ;
    kgx:produces       wd:Q5107 ;
    kgx:relTemplate    "continent" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?cty wdt:P30 ?cn . OPTIONAL { ?cn rdfs:label ?label4 . FILTER(lang(?label4) = \"en\") } OPTIONAL { ?cn wdt:P18 ?image4 } BIND(?cn AS ?p4)" .

}
