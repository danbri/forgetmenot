@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Stacking two filters on the same identity (?p) — the intersection a
# SPARQL planner would compile from the user's "Labour AND female" intent.

<urn:kgx:chain:uk-labour-women-2024> {
  <urn:kgx:chain:uk-labour-women-2024>
    dct:title       "Women on the Labour benches (since 4 July 2024)" ;
    dct:description "Two filter beads stacked: Labour + female. Same identity in both predicates." .

  <urn:kgx:chain:uk-labour-women-2024:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "UK Commons seats whose term started on or after 4 July 2024" ;
    kgx:starterId      "uk-mps-2024" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?seat . ?seat ps:P39 ?pos . ?pos wdt:P279* wd:Q16707842 . ?seat pq:P768 ?cons . ?cons wdt:P17 wd:Q145 . ?seat pq:P580 ?start . FILTER(?start >= \"2024-07-04T00:00:00\"^^xsd:dateTime) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:uk-labour-women-2024:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-labour-women-2024:bead:0> ;
    kgx:gloss          "Members of the Labour Party" ;
    kgx:propertyIri    wdt:P102 ;
    kgx:valueIri       wd:Q9630 ;
    kgx:sparqlFragment "?p wdt:P102 wd:Q9630 ." .

  <urn:kgx:chain:uk-labour-women-2024:bead:2> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-labour-women-2024:bead:1> ;
    kgx:gloss          "Sex or gender = female (Q6581072)" ;
    kgx:propertyIri    wdt:P21 ;
    kgx:valueIri       wd:Q6581072 ;
    kgx:sparqlFragment "?p wdt:P21 wd:Q6581072 ." .
}

