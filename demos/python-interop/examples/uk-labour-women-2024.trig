@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:uk-labour-women-2024> {
  <urn:kgx:chain:uk-labour-women-2024>
    dct:title       "Women on the Labour benches → constituencies → counties → regions" ;
    dct:description "Six atomic filters (humans + UK MP detection + Labour + female) then pivot through Commons constituencies, their administrative parents (counties / unitaries), and the region those sit inside." .

  <urn:kgx:chain:uk-labour-women-2024:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All humans" ;
    kgx:starterId      "humans" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q5 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:uk-labour-women-2024:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-labour-women-2024:bead:0> ;
    kgx:gloss          "Holds at least one P39 position" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?_seat . ?_seat ps:P39 ?_pos ." .

  <urn:kgx:chain:uk-labour-women-2024:bead:2> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-labour-women-2024:bead:1> ;
    kgx:gloss          "The held position derives from UK MP class (Q16707842)" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_pos wdt:P279* wd:Q16707842 ." .

  <urn:kgx:chain:uk-labour-women-2024:bead:3> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-labour-women-2024:bead:2> ;
    kgx:gloss          "The position's constituency qualifier is in a UK constituency" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_seat pq:P768 ?_cons . ?_cons wdt:P17 wd:Q145 ." .

  <urn:kgx:chain:uk-labour-women-2024:bead:4> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-labour-women-2024:bead:3> ;
    kgx:gloss          "Seat's term started on or after the 4 July 2024 GE" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_seat pq:P580 ?_t . FILTER(?_t >= \"2024-07-04T00:00:00\"^^xsd:dateTime)" .

  <urn:kgx:chain:uk-labour-women-2024:bead:5> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-labour-women-2024:bead:4> ;
    kgx:gloss          "Party = Labour" ;
    kgx:propertyIri    wdt:P102 ;
    kgx:valueIri       wd:Q9630 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P102 wd:Q9630 ." .

  <urn:kgx:chain:uk-labour-women-2024:bead:6> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-labour-women-2024:bead:5> ;
    kgx:gloss          "Sex or gender = female (Q6581072)" ;
    kgx:propertyIri    wdt:P21 ;
    kgx:valueIri       wd:Q6581072 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P21 wd:Q6581072 ." .

  <urn:kgx:chain:uk-labour-women-2024:bead:7> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:uk-labour-women-2024:bead:6> ;
    kgx:gloss          "Walk pq:P768 from each seat to the Commons constituency" ;
    kgx:produces       wd:Q192287 ;
    kgx:relTemplate    "constituencies" ;
    kgx:relVariant     "P768" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?_s . ?_s pq:P768 ?cg . OPTIONAL { ?cg rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?cg wdt:P18 ?image1 } BIND(?cg AS ?p1)" .

  <urn:kgx:chain:uk-labour-women-2024:bead:8> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:uk-labour-women-2024:bead:7> ;
    kgx:gloss          "Walk wdt:P131 to the administrative parent (county / unitary)" ;
    kgx:produces       wd:Q193510 ;
    kgx:relTemplate    "county" ;
    kgx:relVariant     "P131" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?cg wdt:P131 ?county . OPTIONAL { ?county rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?county wdt:P18 ?image2 } BIND(?county AS ?p2)" .

  <urn:kgx:chain:uk-labour-women-2024:bead:9> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:uk-labour-women-2024:bead:8> ;
    kgx:gloss          "Walk wdt:P131 once more to land at a region" ;
    kgx:produces       wd:Q15060255 ;
    kgx:relTemplate    "region" ;
    kgx:relVariant     "P131" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?county wdt:P131 ?reg . OPTIONAL { ?reg rdfs:label ?label3 . FILTER(lang(?label3) = \"en\") } OPTIONAL { ?reg wdt:P18 ?image3 } BIND(?reg AS ?p3)" .

}
