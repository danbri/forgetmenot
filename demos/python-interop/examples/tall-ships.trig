@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:tall-ships> {
  <urn:kgx:chain:tall-ships>
    dct:title       "Museum ships → home ports → countries → other ships in those countries" ;
    dct:description "Source: museum ships. Pivot via home port (P504), then country, then inverse-P17 → other museum ships in the same country." .

  <urn:kgx:chain:tall-ships:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All museum ships (Q575727)" ;
    kgx:produces       wd:Q575727 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31/wdt:P279* wd:Q575727 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:tall-ships:bead:1> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:tall-ships:bead:0> ;
    kgx:gloss          "Walk wdt:P504 to home port" ;
    kgx:produces       wd:Q44782 ;
    kgx:relTemplate    "home_port" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P504 ?port . OPTIONAL { ?port rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?port wdt:P18 ?image1 } BIND(?port AS ?p1)" .

  <urn:kgx:chain:tall-ships:bead:2> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:tall-ships:bead:1> ;
    kgx:gloss          "Walk wdt:P17 to the country of the port" ;
    kgx:produces       wd:Q6256 ;
    kgx:relTemplate    "country" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?port wdt:P17 ?cty . OPTIONAL { ?cty rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?cty wdt:P18 ?image2 } BIND(?cty AS ?p2)" .

  <urn:kgx:chain:tall-ships:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:tall-ships:bead:2> ;
    kgx:gloss          "Inverse — other museum ships in the same country" ;
    kgx:produces       wd:Q575727 ;
    kgx:relTemplate    "fleetmates" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_o wdt:P31/wdt:P279* wd:Q575727 . ?_o wdt:P504 ?_p2 . ?_p2 wdt:P17 ?cty . FILTER(?_o != ?p) OPTIONAL { ?_o rdfs:label ?label3 . FILTER(lang(?label3) = \"en\") } OPTIONAL { ?_o wdt:P18 ?image3 } BIND(?_o AS ?p3)" .

}
