@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Museum ships (Q575727). Belém, Cutty Sark, USS Constitution, Vasa.

<urn:kgx:chain:tall-ships> {
  <urn:kgx:chain:tall-ships>
    dct:title       "Famous museum ships" ;
    dct:description "Historic vessels preserved as floating or dry-dock museums — Belém, Cutty Sark, USS Constitution, Vasa." .

  <urn:kgx:chain:tall-ships:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Vessels classified as museum ships (Q575727)" ;
    kgx:produces       wd:Q575727 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31/wdt:P279* wd:Q575727 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}
