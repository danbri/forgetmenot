@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .

# The "matches a paragraph" chain shape — start from a club, walk through
# its members, the books they wrote, the films adapted from those books.
# Each bead is one atomic walk or filter; the cumulative ▶ Run buttons
# trace the lineage at any point.

<urn:kgx:chain:footlights-films> {
  <urn:kgx:chain:footlights-films>
    dct:title       "Cambridge Footlights → members → their notable works → adaptations" ;
    dct:description "Source: the Cambridge Footlights revue. Walk to its members (P463 inverse), filter to actors, pivot to each member's notable works, and finally to films / TV adaptations 'based on' those works (P144 inverse)." .

  <urn:kgx:chain:footlights-films:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "The Cambridge Footlights (Q857679)" ;
    kgx:produces       wd:Q43229 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "VALUES ?p { wd:Q857679 } OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:footlights-films:bead:1> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:footlights-films:bead:0> ;
    kgx:gloss          "Inverse wdt:P463 — people who are members of the Footlights" ;
    kgx:produces       wd:Q5 ;
    kgx:relTemplate    "members" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?member wdt:P463 ?p . OPTIONAL { ?member rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?member wdt:P18 ?image1 } BIND(?member AS ?p1)" .

  <urn:kgx:chain:footlights-films:bead:2> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:footlights-films:bead:1> ;
    kgx:gloss          "Occupation includes actor (Q33999) — narrow to the comic performers" ;
    kgx:propertyIri    wdt:P106 ;
    kgx:valueIri       wd:Q33999 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p1 wdt:P106 wd:Q33999 ." .

  <urn:kgx:chain:footlights-films:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:footlights-films:bead:2> ;
    kgx:gloss          "Walk wdt:P800 to each member's notable works" ;
    kgx:produces       wd:Q386724 ;
    kgx:relTemplate    "notable_works" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p1 wdt:P800 ?work . OPTIONAL { ?work rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?work wdt:P18 ?image2 } BIND(?work AS ?p2)" .

  <urn:kgx:chain:footlights-films:bead:4> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:footlights-films:bead:3> ;
    kgx:gloss          "Inverse wdt:P144 — films / shows 'based on' those works" ;
    kgx:produces       wd:Q11424 ;
    kgx:relTemplate    "adaptations" ;
    kgx:relVariant     "based_on" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?adap wdt:P144 ?p2 . OPTIONAL { ?adap rdfs:label ?label3 . FILTER(lang(?label3) = \"en\") } OPTIONAL { ?adap wdt:P18 ?image3 } BIND(?adap AS ?p3)" .

  <urn:kgx:chain:footlights-films:bead:5> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:footlights-films:bead:4> ;
    kgx:gloss          "Walk wdt:P57 to the director(s) of each adaptation" ;
    kgx:produces       wd:Q5 ;
    kgx:relTemplate    "director" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p3 wdt:P57 ?dir . OPTIONAL { ?dir rdfs:label ?label4 . FILTER(lang(?label4) = \"en\") } OPTIONAL { ?dir wdt:P18 ?image4 } BIND(?dir AS ?p4)" .
}
