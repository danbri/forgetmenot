@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Cocktails (Q134768 in qlever's snapshot). The IBA-list subset isn't
# cleanly modelled, so the chain just returns 'cocktails on Wikidata' —
# Negronis to Sazeracs to the more obscure Italian ones.

<urn:kgx:chain:iba-cocktails> {
  <urn:kgx:chain:iba-cocktails>
    dct:title       "Cocktails on Wikidata" ;
    dct:description "Catalogued cocktails — Negroni, Sazerac, Aperol Spritz, and ~160 others." .

  <urn:kgx:chain:iba-cocktails:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Instances of cocktail (Q134768)" ;
    kgx:produces       wd:Q134768 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q134768 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}
