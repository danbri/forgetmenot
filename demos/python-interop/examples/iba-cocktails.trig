@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:iba-cocktails> {
  <urn:kgx:chain:iba-cocktails>
    dct:title       "Cocktails → ingredients → countries of origin → other cocktails using those ingredients" ;
    dct:description "Source: cocktails. Pivot via P527 (has part) to ingredients, then country of origin of each ingredient, then inverse back to other cocktails using the ingredient." .

  <urn:kgx:chain:iba-cocktails:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Instances of cocktail (Q134768 in qlever's snapshot)" ;
    kgx:produces       wd:Q134768 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q134768 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:iba-cocktails:bead:1> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:iba-cocktails:bead:0> ;
    kgx:gloss          "Walk wdt:P527 (has part) to ingredients" ;
    kgx:produces       wd:Q2095 ;
    kgx:relTemplate    "ingredients" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P527 ?ing . OPTIONAL { ?ing rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?ing wdt:P18 ?image1 } BIND(?ing AS ?p1)" .

  <urn:kgx:chain:iba-cocktails:bead:2> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:iba-cocktails:bead:1> ;
    kgx:gloss          "Walk wdt:P495 (country of origin) of each ingredient" ;
    kgx:produces       wd:Q6256 ;
    kgx:relTemplate    "country_of_ingredient" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?ing wdt:P495 ?cty . OPTIONAL { ?cty rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?cty wdt:P18 ?image2 } BIND(?cty AS ?p2)" .

  <urn:kgx:chain:iba-cocktails:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:iba-cocktails:bead:2> ;
    kgx:gloss          "Inverse — other cocktails using the same ingredient" ;
    kgx:produces       wd:Q134768 ;
    kgx:relTemplate    "cousin_cocktails" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_oc wdt:P31 wd:Q134768 . ?_oc wdt:P527 ?ing . FILTER(?_oc != ?p) OPTIONAL { ?_oc rdfs:label ?label3 . FILTER(lang(?label3) = \"en\") } OPTIONAL { ?_oc wdt:P18 ?image3 } BIND(?_oc AS ?p3)" .

}
