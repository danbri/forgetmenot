@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Same shape as UK MPs, retargeted at wd:Q4416090 (United States Senator).
# Positive temporal anchor: P580 ≥ 2023-01-03 — 118th Congress onward.

<urn:kgx:chain:us-senators> {
  <urn:kgx:chain:us-senators>
    dct:title       "US Senators sworn in since 2023" ;
    dct:description "Holders of wd:Q4416090 (United States Senator) whose seat started on or after the 118th Congress." .

  <urn:kgx:chain:us-senators:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "US Senate seats whose term started on or after the 118th Congress (3 January 2023)" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?seat . ?seat ps:P39 wd:Q4416090 . ?seat pq:P580 ?start . FILTER(?start >= \"2023-01-03T00:00:00\"^^xsd:dateTime) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

