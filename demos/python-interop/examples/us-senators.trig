@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:us-senators> {
  <urn:kgx:chain:us-senators>
    dct:title       "US Senators since 2023 → their states → state capitals" ;
    dct:description "Three filter beads detect Senate seats of the 118th Congress, then pivot through the represented state and that state's capital." .

  <urn:kgx:chain:us-senators:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All humans" ;
    kgx:starterId      "humans" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q5 . FILTER(STRSTARTS(STR(?p), \"http://www.wikidata.org/entity/Q\")) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:us-senators:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:us-senators:bead:0> ;
    kgx:gloss          "Holds a P39 position" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?_seat . ?_seat ps:P39 ?_pos ." .

  <urn:kgx:chain:us-senators:bead:2> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:us-senators:bead:1> ;
    kgx:gloss          "Position is United States Senator (Q4416090)" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_pos wdt:P279* wd:Q4416090 ." .

  <urn:kgx:chain:us-senators:bead:3> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:us-senators:bead:2> ;
    kgx:gloss          "Seat started on or after 3 January 2023 (118th Congress)" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_seat pq:P580 ?_t . FILTER(?_t >= \"2023-01-03T00:00:00\"^^xsd:dateTime)" .

  <urn:kgx:chain:us-senators:bead:4> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:us-senators:bead:3> ;
    kgx:gloss          "Walk pq:P768 to the represented state" ;
    kgx:produces       wd:Q35657 ;
    kgx:relTemplate    "state" ;
    kgx:relVariant     "P768" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_seat pq:P768 ?st . OPTIONAL { ?st rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?st wdt:P18 ?image1 } BIND(?st AS ?p1)" .

  <urn:kgx:chain:us-senators:bead:5> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:us-senators:bead:4> ;
    kgx:gloss          "Walk wdt:P36 to the capital of the state" ;
    kgx:produces       wd:Q5119 ;
    kgx:relTemplate    "capital" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?st wdt:P36 ?cap . OPTIONAL { ?cap rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?cap wdt:P18 ?image2 } BIND(?cap AS ?p2)" .

}
