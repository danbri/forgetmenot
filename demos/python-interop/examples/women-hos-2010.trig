@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:women-hos-2010> {
  <urn:kgx:chain:women-hos-2010>
    dct:title       "Women heads of state since 2010 → countries → continents" ;
    dct:description "Five atomic beads: humans → female → head-of-state office → office started ≥ 2010 → country (P1001) → continent." .

  <urn:kgx:chain:women-hos-2010:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All humans" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q5 . FILTER(STRSTARTS(STR(?p), \"http://www.wikidata.org/entity/Q\")) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:women-hos-2010:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:women-hos-2010:bead:0> ;
    kgx:gloss          "Sex or gender = female" ;
    kgx:propertyIri    wdt:P21 ;
    kgx:valueIri       wd:Q6581072 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P21 wd:Q6581072 ." .

  <urn:kgx:chain:women-hos-2010:bead:2> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:women-hos-2010:bead:1> ;
    kgx:gloss          "Held a head-of-state class position" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?_off . ?_off ps:P39 ?_pos . ?_pos wdt:P279* wd:Q48352 ." .

  <urn:kgx:chain:women-hos-2010:bead:3> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:women-hos-2010:bead:2> ;
    kgx:gloss          "Position started on or after 1 January 2010" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_off pq:P580 ?_t . FILTER(?_t >= \"2010-01-01T00:00:00\"^^xsd:dateTime)" .

  <urn:kgx:chain:women-hos-2010:bead:4> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:women-hos-2010:bead:3> ;
    kgx:gloss          "Walk wdt:P1001 to the country of that position" ;
    kgx:produces       wd:Q6256 ;
    kgx:relTemplate    "country" ;
    kgx:relVariant     "of_position" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_pos wdt:P1001 ?cty . OPTIONAL { ?cty rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?cty wdt:P18 ?image1 } BIND(?cty AS ?p1)" .

  <urn:kgx:chain:women-hos-2010:bead:5> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:women-hos-2010:bead:4> ;
    kgx:gloss          "Walk wdt:P30 to the continent of the country" ;
    kgx:produces       wd:Q5107 ;
    kgx:relTemplate    "continent" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?cty wdt:P30 ?cn . OPTIONAL { ?cn rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?cn wdt:P18 ?image2 } BIND(?cn AS ?p2)" .

}
