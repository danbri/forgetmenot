@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Anyone whose held a Q48352 (head of state) class position with start
# date on or after 2010, and whose gender is female. Positive temporal
# anchor + positive gender filter.

<urn:kgx:chain:women-hos-2010> {
  <urn:kgx:chain:women-hos-2010>
    dct:title       "Women heads of state taking office since 2010" ;
    dct:description "Female heads of state whose term started on or after 2010-01-01." .

  <urn:kgx:chain:women-hos-2010:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Heads of state whose term started on or after 2010-01-01" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?off . ?off ps:P39 ?pos . ?pos wdt:P279* wd:Q48352 . ?off pq:P580 ?start . FILTER(?start >= \"2010-01-01T00:00:00\"^^xsd:dateTime) ?p wdt:P21 wd:Q6581072 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

