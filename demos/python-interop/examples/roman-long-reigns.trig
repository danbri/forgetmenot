@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:roman-long-reigns> {
  <urn:kgx:chain:roman-long-reigns>
    dct:title       "Long-reigning Roman emperors → dynasties → their predecessors → fathers" ;
    dct:description "Two filter beads (emperor + reign ≥ 20 yr), then pivot through dynasty (P53), predecessor in office (P155), and the predecessor's father (P22)." .

  <urn:kgx:chain:roman-long-reigns:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All humans" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q5 . FILTER(STRSTARTS(STR(?p), \"http://www.wikidata.org/entity/Q\")) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:roman-long-reigns:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:roman-long-reigns:bead:0> ;
    kgx:gloss          "Holds Q842606 (Roman Emperor)" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?_st . ?_st ps:P39 wd:Q842606 ; pq:P580 ?_s ; pq:P582 ?_e ." .

  <urn:kgx:chain:roman-long-reigns:bead:2> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:roman-long-reigns:bead:1> ;
    kgx:gloss          "Reign duration ≥ 20 years" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "FILTER( (YEAR(?_e) - YEAR(?_s)) >= 20 )" .

  <urn:kgx:chain:roman-long-reigns:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:roman-long-reigns:bead:2> ;
    kgx:gloss          "Walk wdt:P53 to the noble family / dynasty" ;
    kgx:produces       wd:Q164950 ;
    kgx:relTemplate    "dynasty" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P53 ?dyn . OPTIONAL { ?dyn rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?dyn wdt:P18 ?image1 } BIND(?dyn AS ?p1)" .

  <urn:kgx:chain:roman-long-reigns:bead:4> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:roman-long-reigns:bead:3> ;
    kgx:gloss          "Walk inverse wdt:P155 — emperors whose dynasty matches" ;
    kgx:produces       wd:Q5 ;
    kgx:relTemplate    "dynasty_member" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?other wdt:P53 ?dyn . ?other wdt:P31 wd:Q5 . OPTIONAL { ?other rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?other wdt:P18 ?image2 } BIND(?other AS ?p2)" .

  <urn:kgx:chain:roman-long-reigns:bead:5> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:roman-long-reigns:bead:4> ;
    kgx:gloss          "Walk wdt:P22 to their father" ;
    kgx:produces       wd:Q5 ;
    kgx:relTemplate    "father" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?other wdt:P22 ?dad . OPTIONAL { ?dad rdfs:label ?label3 . FILTER(lang(?label3) = \"en\") } OPTIONAL { ?dad wdt:P18 ?image3 } BIND(?dad AS ?p3)" .

}
