@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Roman emperors (P39 = Q842606) whose reign lasted 20+ years.

<urn:kgx:chain:roman-long-reigns> {
  <urn:kgx:chain:roman-long-reigns>
    dct:title       "Roman emperors who reigned 20+ years" ;
    dct:description "Roman emperors with (P582 − P580) on their imperial position ≥ 20 years. Augustus, Tiberius, Theodosius II." .

  <urn:kgx:chain:roman-long-reigns:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Holders of Q842606 with reign duration ≥ 20 years" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?st . ?st ps:P39 wd:Q842606 ; pq:P580 ?s ; pq:P582 ?e . FILTER( (YEAR(?e) - YEAR(?s)) >= 20 ) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

