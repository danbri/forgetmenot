# Films (Q11424) directed by Christopher Nolan (Q25191).

<urn:kgx:chain:nolan-films> {
  <urn:kgx:chain:nolan-films>
    dct:title       "Films directed by Christopher Nolan" ;
    dct:description "wd:Q25191 (Christopher Nolan) ← P57 ← any wd:Q11424 (film)." .

  <urn:kgx:chain:nolan-films:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Films directed by Christopher Nolan" ;
