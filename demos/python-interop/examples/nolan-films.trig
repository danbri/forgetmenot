@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:nolan-films> {
  <urn:kgx:chain:nolan-films>
    dct:title       "Christopher Nolan → his films → lead cast → their occupations" ;
    dct:description "Source: Nolan himself. Pivot to films he directed (inverse-P57), filter to film instances, pivot to cast members, then to their occupations." .

  <urn:kgx:chain:nolan-films:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Christopher Nolan" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "VALUES ?p { wd:Q25191 } OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:nolan-films:bead:1> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:nolan-films:bead:0> ;
    kgx:gloss          "Inverse wdt:P57 — films he directed" ;
    kgx:produces       wd:Q11424 ;
    kgx:relTemplate    "films_directed" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_f wdt:P57 ?p . OPTIONAL { ?_f rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?_f wdt:P18 ?image1 } BIND(?_f AS ?p1)" .

  <urn:kgx:chain:nolan-films:bead:2> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:nolan-films:bead:1> ;
    kgx:gloss          "Is a film (Q11424)" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p1 wdt:P31/wdt:P279* wd:Q11424 ." .

  <urn:kgx:chain:nolan-films:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:nolan-films:bead:2> ;
    kgx:gloss          "Walk wdt:P161 to cast members" ;
    kgx:produces       wd:Q5 ;
    kgx:relTemplate    "cast" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p1 wdt:P161 ?actor . OPTIONAL { ?actor rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?actor wdt:P18 ?image2 } BIND(?actor AS ?p2)" .

  <urn:kgx:chain:nolan-films:bead:4> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:nolan-films:bead:3> ;
    kgx:gloss          "Walk wdt:P106 to occupations of those cast members" ;
    kgx:produces       wd:Q12737077 ;
    kgx:relTemplate    "occupations" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?actor wdt:P106 ?occ . OPTIONAL { ?occ rdfs:label ?label3 . FILTER(lang(?label3) = \"en\") } OPTIONAL { ?occ wdt:P18 ?image3 } BIND(?occ AS ?p3)" .

}
