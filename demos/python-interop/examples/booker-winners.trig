@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:booker-winners> {
  <urn:kgx:chain:booker-winners>
    dct:title       "Booker Prize winners → their winning books → genres → fellow authors" ;
    dct:description "Filter to Booker laureates; pivots to notable work, the work's genre, and other authors writing in that genre." .

  <urn:kgx:chain:booker-winners:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All humans" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q5 . FILTER(STRSTARTS(STR(?p), \"http://www.wikidata.org/entity/Q\")) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:booker-winners:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:booker-winners:bead:0> ;
    kgx:gloss          "Holds P166 = Booker Prize (Q160082)" ;
    kgx:propertyIri    wdt:P166 ;
    kgx:valueIri       wd:Q160082 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P166 wd:Q160082 ." .

  <urn:kgx:chain:booker-winners:bead:2> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:booker-winners:bead:1> ;
    kgx:gloss          "Walk wdt:P800 to each author's notable work" ;
    kgx:produces       wd:Q571 ;
    kgx:relTemplate    "notable_work" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P800 ?bk . OPTIONAL { ?bk rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?bk wdt:P18 ?image1 } BIND(?bk AS ?p1)" .

  <urn:kgx:chain:booker-winners:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:booker-winners:bead:2> ;
    kgx:gloss          "Walk wdt:P136 to the genre of the book" ;
    kgx:produces       wd:Q483394 ;
    kgx:relTemplate    "genre" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?bk wdt:P136 ?gen . OPTIONAL { ?gen rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?gen wdt:P18 ?image2 } BIND(?gen AS ?p2)" .

  <urn:kgx:chain:booker-winners:bead:4> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:booker-winners:bead:3> ;
    kgx:gloss          "Inverse wdt:P136 from other books → their authors via wdt:P50" ;
    kgx:produces       wd:Q5 ;
    kgx:relTemplate    "other_genre_authors" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_ob wdt:P136 ?gen . ?_ob wdt:P50 ?auth . FILTER(?auth != ?p) OPTIONAL { ?auth rdfs:label ?label3 . FILTER(lang(?label3) = \"en\") } OPTIONAL { ?auth wdt:P18 ?image3 } BIND(?auth AS ?p3)" .

}
