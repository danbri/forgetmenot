@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Winners of the Booker Prize (Q187100). Wikidata models the laureate via
# P166 on the person; the winning work is P800 (notable work).

<urn:kgx:chain:booker-winners> {
  <urn:kgx:chain:booker-winners>
    dct:title       "Booker Prize winners" ;
    dct:description "People who have been awarded wd:Q160082 (Booker Prize)." .

  <urn:kgx:chain:booker-winners:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Holders of P166 = Booker Prize" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P166 wd:Q160082 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

