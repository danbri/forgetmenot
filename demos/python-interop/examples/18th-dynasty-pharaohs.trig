@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:18th-dynasty-pharaohs> {
  <urn:kgx:chain:18th-dynasty-pharaohs>
    dct:title       "Pharaohs of the Eighteenth Dynasty" ;
    dct:description "Members of the 18th Dynasty (Q12554) — Hatshepsut, Akhenaten, Tutankhamun. Single-bead: qlever's snapshot has too-sparse wdt:* coverage for clean pivots on these entities." .

  <urn:kgx:chain:18th-dynasty-pharaohs:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "House membership = 18th Dynasty of Egypt" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P53 wd:Q12554 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

}
