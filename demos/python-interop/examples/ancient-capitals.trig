@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Cities that are capitals (P1376) and whose inception (P571) is before
# 1000 AD. Positive temporal filter.

<urn:kgx:chain:ancient-capitals> {
  <urn:kgx:chain:ancient-capitals>
    dct:title       "Capital cities founded before 1000 AD" ;
    dct:description "Cities marked as capital of some country, with inception earlier than 1000-01-01." .

  <urn:kgx:chain:ancient-capitals:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Capital cities with P571 < 1000-01-01" ;
    kgx:produces       wd:Q5119 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P1376 ?country . ?p wdt:P571 ?inception . FILTER(?inception < \"1000-01-01T00:00:00\"^^xsd:dateTime) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

