@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:ancient-capitals> {
  <urn:kgx:chain:ancient-capitals>
    dct:title       "Ancient capitals → countries → continents" ;
    dct:description "Two filters (capital city of some country + inception before 1000 AD), then pivot to country and continent." .

  <urn:kgx:chain:ancient-capitals:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All capital cities" ;
    kgx:produces       wd:Q5119 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P1376 ?_country . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:ancient-capitals:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:ancient-capitals:bead:0> ;
    kgx:gloss          "Inception (P571) earlier than 1000-01-01" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P571 ?_t . FILTER(?_t < \"1000-01-01T00:00:00\"^^xsd:dateTime)" .

  <urn:kgx:chain:ancient-capitals:bead:2> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:ancient-capitals:bead:1> ;
    kgx:gloss          "Walk wdt:P1376 to the country the city is capital of" ;
    kgx:produces       wd:Q6256 ;
    kgx:relTemplate    "country" ;
    kgx:relVariant     "capital_of" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P1376 ?cty . OPTIONAL { ?cty rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?cty wdt:P18 ?image1 } BIND(?cty AS ?p1)" .

  <urn:kgx:chain:ancient-capitals:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:ancient-capitals:bead:2> ;
    kgx:gloss          "Walk wdt:P30 to the continent of that country" ;
    kgx:produces       wd:Q5107 ;
    kgx:relTemplate    "continent" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?cty wdt:P30 ?cn . OPTIONAL { ?cn rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?cn wdt:P18 ?image2 } BIND(?cn AS ?p2)" .

}
