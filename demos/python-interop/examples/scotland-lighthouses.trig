@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:scotland-lighthouses> {
  <urn:kgx:chain:scotland-lighthouses>
    dct:title       "Scottish lighthouses → council areas → constituencies → current MPs" ;
    dct:description "Three pivots: walk wdt:P131 from the lighthouse to its council area, then to UK Parliament constituencies sitting in that area, then to the current MP via inverse-pq:P768." .

  <urn:kgx:chain:scotland-lighthouses:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All lighthouses (Q39715) inside Scotland (Q22)" ;
    kgx:produces       wd:Q39715 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31/wdt:P279* wd:Q39715 . ?p wdt:P131* wd:Q22 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:scotland-lighthouses:bead:1> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:scotland-lighthouses:bead:0> ;
    kgx:gloss          "Walk wdt:P131 to immediate administrative parent" ;
    kgx:produces       wd:Q15060255 ;
    kgx:relTemplate    "council_area" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P131 ?ca . OPTIONAL { ?ca rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?ca wdt:P18 ?image1 } BIND(?ca AS ?p1)" .

  <urn:kgx:chain:scotland-lighthouses:bead:2> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:scotland-lighthouses:bead:1> ;
    kgx:gloss          "Inverse wdt:P131+ — UK Parliament constituencies inside that council area" ;
    kgx:produces       wd:Q192287 ;
    kgx:relTemplate    "constituencies" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_cg wdt:P131+ ?ca . ?_cg wdt:P31 wd:Q192287 . OPTIONAL { ?_cg rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?_cg wdt:P18 ?image2 } BIND(?_cg AS ?p2)" .

  <urn:kgx:chain:scotland-lighthouses:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:scotland-lighthouses:bead:2> ;
    kgx:gloss          "Inverse pq:P768 — current MP for each constituency" ;
    kgx:produces       wd:Q5 ;
    kgx:relTemplate    "current_mp" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_seat pq:P768 ?_cg . ?_seat ps:P39 ?_pos . ?_pos wdt:P279* wd:Q16707842 . ?_seat pq:P580 ?_t . FILTER(?_t >= \"2024-07-04T00:00:00\"^^xsd:dateTime) ?mp p:P39 ?_seat . OPTIONAL { ?mp rdfs:label ?label3 . FILTER(lang(?label3) = \"en\") } OPTIONAL { ?mp wdt:P18 ?image3 } BIND(?mp AS ?p3)" .

}
