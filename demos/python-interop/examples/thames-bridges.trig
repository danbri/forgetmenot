@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Bridges (Q12280) that cross (P177) the River Thames (Q19686).

<urn:kgx:chain:thames-bridges> {
  <urn:kgx:chain:thames-bridges>
    dct:title       "Bridges over the River Thames" ;
    dct:description "wd:Q12280 (bridge) wdt:P177 wd:Q19686 (Thames)." .

  <urn:kgx:chain:thames-bridges:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Bridges crossing the River Thames" ;
    kgx:produces       wd:Q12280 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31/wdt:P279* wd:Q12280 ; wdt:P177 wd:Q19686 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

