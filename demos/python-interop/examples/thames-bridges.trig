@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:thames-bridges> {
  <urn:kgx:chain:thames-bridges>
    dct:title       "Thames bridges → architects → their other works → cities of those works" ;
    dct:description "Two filter beads (bridge + crosses Thames), then pivots to architect, the architect's other works (inverse-P84), and the city those sit in." .

  <urn:kgx:chain:thames-bridges:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All bridges (Q12280)" ;
    kgx:produces       wd:Q12280 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31/wdt:P279* wd:Q12280 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:thames-bridges:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:thames-bridges:bead:0> ;
    kgx:gloss          "Crosses the River Thames (Q19686)" ;
    kgx:propertyIri    wdt:P177 ;
    kgx:valueIri       wd:Q19686 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P177 wd:Q19686 ." .

  <urn:kgx:chain:thames-bridges:bead:2> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:thames-bridges:bead:1> ;
    kgx:gloss          "Walk wdt:P84 to the architect of each bridge" ;
    kgx:produces       wd:Q5 ;
    kgx:relTemplate    "architect" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P84 ?arch . OPTIONAL { ?arch rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?arch wdt:P18 ?image1 } BIND(?arch AS ?p1)" .

  <urn:kgx:chain:thames-bridges:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:thames-bridges:bead:2> ;
    kgx:gloss          "Inverse wdt:P84 — other works by those architects" ;
    kgx:produces       wd:Q41176 ;
    kgx:relTemplate    "other_works" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_o wdt:P84 ?arch . FILTER(?_o != ?p) OPTIONAL { ?_o rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?_o wdt:P18 ?image2 } BIND(?_o AS ?p2)" .

  <urn:kgx:chain:thames-bridges:bead:4> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:thames-bridges:bead:3> ;
    kgx:gloss          "Walk wdt:P131 to the city the work sits in" ;
    kgx:produces       wd:Q486972 ;
    kgx:relTemplate    "city" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_o wdt:P131 ?city . ?city wdt:P31/wdt:P279* wd:Q486972 . OPTIONAL { ?city rdfs:label ?label3 . FILTER(lang(?label3) = \"en\") } OPTIONAL { ?city wdt:P18 ?image3 } BIND(?city AS ?p3)" .

}
