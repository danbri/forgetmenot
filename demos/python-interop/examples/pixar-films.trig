@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:pixar-films> {
  <urn:kgx:chain:pixar-films>
    dct:title       "Pixar → their films → directors → directors' other works" ;
    dct:description "Source: Pixar itself. Inverse-P272 to films, filter to film instances, pivot to directors, then walk inverse-P57 to their other directed works." .

  <urn:kgx:chain:pixar-films:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Pixar (Q127552)" ;
    kgx:produces       wd:Q43229 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "VALUES ?p { wd:Q127552 } OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:pixar-films:bead:1> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:pixar-films:bead:0> ;
    kgx:gloss          "Inverse wdt:P272 — films produced by Pixar" ;
    kgx:produces       wd:Q11424 ;
    kgx:relTemplate    "films_produced" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_f wdt:P272 ?p . OPTIONAL { ?_f rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?_f wdt:P18 ?image1 } BIND(?_f AS ?p1)" .

  <urn:kgx:chain:pixar-films:bead:2> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:pixar-films:bead:1> ;
    kgx:gloss          "Is a film (Q11424)" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p1 wdt:P31/wdt:P279* wd:Q11424 ." .

  <urn:kgx:chain:pixar-films:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:pixar-films:bead:2> ;
    kgx:gloss          "Walk wdt:P57 to the director of each film" ;
    kgx:produces       wd:Q5 ;
    kgx:relTemplate    "director" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p1 wdt:P57 ?dir . OPTIONAL { ?dir rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?dir wdt:P18 ?image2 } BIND(?dir AS ?p2)" .

  <urn:kgx:chain:pixar-films:bead:4> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:pixar-films:bead:3> ;
    kgx:gloss          "Inverse wdt:P57 — other films directed by those directors" ;
    kgx:produces       wd:Q11424 ;
    kgx:relTemplate    "other_films" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_o wdt:P57 ?dir . OPTIONAL { ?_o rdfs:label ?label3 . FILTER(lang(?label3) = \"en\") } OPTIONAL { ?_o wdt:P18 ?image3 } BIND(?_o AS ?p3)" .

}
