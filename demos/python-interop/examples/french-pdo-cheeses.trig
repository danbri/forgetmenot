@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# French cheeses (Q10943 in country Q142). Wikidata's PDO modelling is
# inconsistent enough that filtering on PDO drops most cheeses; we keep
# this as 'French cheeses' to stay honest about coverage.

<urn:kgx:chain:french-pdo-cheeses> {
  <urn:kgx:chain:french-pdo-cheeses>
    dct:title       "French cheeses on Wikidata" ;
    dct:description "Cheeses (Q10943) in country France (Q142). Roquefort, Comté, Brie, Camembert." .

  <urn:kgx:chain:french-pdo-cheeses:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Cheeses with country of origin France" ;
    kgx:produces       wd:Q10943 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31/wdt:P279* wd:Q10943 ; wdt:P495 wd:Q142 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}
