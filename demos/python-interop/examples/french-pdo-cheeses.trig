@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:french-pdo-cheeses> {
  <urn:kgx:chain:french-pdo-cheeses>
    dct:title       "French cheeses → regions → wines made in the same regions" ;
    dct:description "Two filters (cheese class + country = France); pivots walk to the region of origin and then inverse to French wines from that region." .

  <urn:kgx:chain:french-pdo-cheeses:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All cheeses (Q10943)" ;
    kgx:produces       wd:Q10943 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31/wdt:P279* wd:Q10943 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:french-pdo-cheeses:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:french-pdo-cheeses:bead:0> ;
    kgx:gloss          "Country of origin = France (Q142)" ;
    kgx:propertyIri    wdt:P495 ;
    kgx:valueIri       wd:Q142 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P495 wd:Q142 ." .

  <urn:kgx:chain:french-pdo-cheeses:bead:2> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:french-pdo-cheeses:bead:1> ;
    kgx:gloss          "Walk wdt:P131 | wdt:P276 to the region where present" ;
    kgx:produces       wd:Q36784 ;
    kgx:relTemplate    "region" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P131|wdt:P276 ?reg . OPTIONAL { ?reg rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?reg wdt:P18 ?image1 } BIND(?reg AS ?p1)" .

  <urn:kgx:chain:french-pdo-cheeses:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:french-pdo-cheeses:bead:2> ;
    kgx:gloss          "Inverse wdt:P131 — wines from the same region" ;
    kgx:produces       wd:Q282 ;
    kgx:relTemplate    "wines" ;
    kgx:relVariant     "region_match" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?wn wdt:P31/wdt:P279* wd:Q282 . ?wn wdt:P131 ?reg . OPTIONAL { ?wn rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?wn wdt:P18 ?image2 } BIND(?wn AS ?p2)" .

}
