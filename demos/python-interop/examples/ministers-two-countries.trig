@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:ministers-two-countries> {
  <urn:kgx:chain:ministers-two-countries>
    dct:title       "Cross-border ministers → the two countries they served → continents" ;
    dct:description "Source bead matches anyone holding minister roles in two different country contexts; pivots walk to both country labels and the continent." .

  <urn:kgx:chain:ministers-two-countries:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Minister roles in two different countries" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q5 . ?p wdt:P39 ?r1 . ?r1 wdt:P279* wd:Q83307 . ?r1 wdt:P17 ?c1 . ?p wdt:P39 ?r2 . ?r2 wdt:P279* wd:Q83307 . ?r2 wdt:P17 ?c2 . FILTER(?c1 != ?c2) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:ministers-two-countries:bead:1> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:ministers-two-countries:bead:0> ;
    kgx:gloss          "Walk through P17 of any minister role of this person" ;
    kgx:produces       wd:Q6256 ;
    kgx:relTemplate    "countries" ;
    kgx:relVariant     "union" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P39 ?_r . ?_r wdt:P279* wd:Q83307 . ?_r wdt:P17 ?cty . OPTIONAL { ?cty rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?cty wdt:P18 ?image1 } BIND(?cty AS ?p1)" .

  <urn:kgx:chain:ministers-two-countries:bead:2> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:ministers-two-countries:bead:1> ;
    kgx:gloss          "Walk wdt:P30 to the continent" ;
    kgx:produces       wd:Q5107 ;
    kgx:relTemplate    "continent" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?cty wdt:P30 ?cn . OPTIONAL { ?cn rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?cn wdt:P18 ?image2 } BIND(?cn AS ?p2)" .

}
