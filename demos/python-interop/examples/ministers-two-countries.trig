@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# People who have held minister-class positions (Q83307) in at least two
# different country contexts (P17 of the position). Positive intersection
# implemented in one SPARQL — the kgx:IntersectBundle structural form is
# the optimiser's compile target, not a precondition.

<urn:kgx:chain:ministers-two-countries> {
  <urn:kgx:chain:ministers-two-countries>
    dct:title       "People who served as ministers in two different countries" ;
    dct:description "Holders of any Q83307 (minister) class position, in two different country contexts. Curious cross-border careers." .

  <urn:kgx:chain:ministers-two-countries:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "People with minister-class roles in two different countries" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P39 ?r1 . ?r1 wdt:P279* wd:Q83307 . ?r1 wdt:P17 ?c1 . ?p wdt:P39 ?r2 . ?r2 wdt:P279* wd:Q83307 . ?r2 wdt:P17 ?c2 . FILTER(?c1 != ?c2) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

