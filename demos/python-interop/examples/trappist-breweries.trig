@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:trappist-breweries> {
  <urn:kgx:chain:trappist-breweries>
    dct:title       "Belgian breweries → provinces → cities → other breweries in the same city" ;
    dct:description "Two filters (brewery class + country = Belgium), then pivots to province → cities of those provinces → other breweries there." .

  <urn:kgx:chain:trappist-breweries:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All breweries (Q131734 in qlever's snapshot)" ;
    kgx:produces       wd:Q131734 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31/wdt:P279* wd:Q131734 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:trappist-breweries:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:trappist-breweries:bead:0> ;
    kgx:gloss          "Country = Belgium (Q31)" ;
    kgx:propertyIri    wdt:P17 ;
    kgx:valueIri       wd:Q31 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P17 wd:Q31 ." .

  <urn:kgx:chain:trappist-breweries:bead:2> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:trappist-breweries:bead:1> ;
    kgx:gloss          "Walk wdt:P131 to the administrative parent (province)" ;
    kgx:produces       wd:Q83195 ;
    kgx:relTemplate    "province" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P131 ?pv . OPTIONAL { ?pv rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?pv wdt:P18 ?image1 } BIND(?pv AS ?p1)" .

  <urn:kgx:chain:trappist-breweries:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:trappist-breweries:bead:2> ;
    kgx:gloss          "Inverse wdt:P131 — cities inside that province" ;
    kgx:produces       wd:Q486972 ;
    kgx:relTemplate    "city" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?city wdt:P131 ?pv . ?city wdt:P31/wdt:P279* wd:Q486972 . OPTIONAL { ?city rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?city wdt:P18 ?image2 } BIND(?city AS ?p2)" .

  <urn:kgx:chain:trappist-breweries:bead:4> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:trappist-breweries:bead:3> ;
    kgx:gloss          "Inverse wdt:P131 — other breweries in those cities" ;
    kgx:produces       wd:Q131734 ;
    kgx:relTemplate    "other_breweries" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_b wdt:P131 ?city . ?_b wdt:P31/wdt:P279* wd:Q131734 . FILTER(?_b != ?p) OPTIONAL { ?_b rdfs:label ?label3 . FILTER(lang(?label3) = \"en\") } OPTIONAL { ?_b wdt:P18 ?image3 } BIND(?_b AS ?p3)" .

}
