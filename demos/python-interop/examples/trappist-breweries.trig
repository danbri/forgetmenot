@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Belgian breweries (Q41680 in country Q31). The Trappist subset is
# poorly modelled on Wikidata — use the broader 'breweries in Belgium'
# query instead, then look for 'Trappist' / 'Abbey' in the names.

<urn:kgx:chain:trappist-breweries> {
  <urn:kgx:chain:trappist-breweries>
    dct:title       "Breweries in Belgium" ;
    dct:description "Belgian breweries on Wikidata — includes the Trappist greats among many others." .

  <urn:kgx:chain:trappist-breweries:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Breweries with country Belgium" ;
    kgx:produces       wd:Q131734 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31/wdt:P279* wd:Q131734 ; wdt:P17 wd:Q31 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}
