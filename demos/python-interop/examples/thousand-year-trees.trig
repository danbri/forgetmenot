@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:thousand-year-trees> {
  <urn:kgx:chain:thousand-year-trees>
    dct:title       "Trees confirmed over 1 000 years old → countries → continents" ;
    dct:description "Two filters (individual tree + inception ≤ 1025-01-01), then pivot to country and continent." .

  <urn:kgx:chain:thousand-year-trees:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All individual trees (Q10884)" ;
    kgx:produces       wd:Q10884 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31/wdt:P279* wd:Q10884 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:thousand-year-trees:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:thousand-year-trees:bead:0> ;
    kgx:gloss          "Inception (P571) earlier than 1025-01-01" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P571 ?_t . FILTER(?_t < \"1025-01-01T00:00:00\"^^xsd:dateTime)" .

  <urn:kgx:chain:thousand-year-trees:bead:2> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:thousand-year-trees:bead:1> ;
    kgx:gloss          "Walk wdt:P17 to the country of each tree" ;
    kgx:produces       wd:Q6256 ;
    kgx:relTemplate    "country" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P17 ?cty . OPTIONAL { ?cty rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?cty wdt:P18 ?image1 } BIND(?cty AS ?p1)" .

  <urn:kgx:chain:thousand-year-trees:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:thousand-year-trees:bead:2> ;
    kgx:gloss          "Walk wdt:P30 to the continent" ;
    kgx:produces       wd:Q5107 ;
    kgx:relTemplate    "continent" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?cty wdt:P30 ?cn . OPTIONAL { ?cn rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?cn wdt:P18 ?image2 } BIND(?cn AS ?p2)" .

}
