@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Individual trees with an inception (P571) date older than 1 000 years
# ago. The query uses a parameterised cut-off date.

<urn:kgx:chain:thousand-year-trees> {
  <urn:kgx:chain:thousand-year-trees>
    dct:title       "Trees confirmed over 1 000 years old" ;
    dct:description "Individual trees (wd:Q10884) with planting / inception date earlier than 1025-01-01." .

  <urn:kgx:chain:thousand-year-trees:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Individual trees with P571 earlier than 1025-01-01" ;
    kgx:produces       wd:Q10884 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31/wdt:P279* wd:Q10884 . ?p wdt:P571 ?inception . FILTER(?inception < \"1025-01-01T00:00:00\"^^xsd:dateTime) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

