@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Anyone awarded the Nobel Prize in Physics (Q38104).

<urn:kgx:chain:nobel-physics> {
  <urn:kgx:chain:nobel-physics>
    dct:title       "Nobel laureates in Physics" ;
    dct:description "Everyone who has been awarded wd:Q38104 (Nobel Prize in Physics) — Curie to Hassabis." .

  <urn:kgx:chain:nobel-physics:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Holders of P166 = Q38104 (Nobel Prize in Physics)" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P166 wd:Q38104 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

