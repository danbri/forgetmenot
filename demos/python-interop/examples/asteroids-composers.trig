@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:asteroids-composers> {
  <urn:kgx:chain:asteroids-composers>
    dct:title       "Asteroids named after composers → the composers → their countries → continents" ;
    dct:description "Source: asteroids whose namesake is a composer. Three pivots walk to the composer, their country of citizenship, and the continent of that country." .

  <urn:kgx:chain:asteroids-composers:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Asteroids whose namesake (P138) is a composer" ;
    kgx:produces       wd:Q3863 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q3863 ; wdt:P138 ?_ns . ?_ns wdt:P106 wd:Q36834 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:asteroids-composers:bead:1> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:asteroids-composers:bead:0> ;
    kgx:gloss          "Walk wdt:P138 to the composer the asteroid honours" ;
    kgx:produces       wd:Q5 ;
    kgx:relTemplate    "namesake" ;
    kgx:relVariant     "composer" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P138 ?person . ?person wdt:P106 wd:Q36834 . OPTIONAL { ?person rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?person wdt:P18 ?image1 } BIND(?person AS ?p1)" .

  <urn:kgx:chain:asteroids-composers:bead:2> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:asteroids-composers:bead:1> ;
    kgx:gloss          "Walk wdt:P27 to country of citizenship" ;
    kgx:produces       wd:Q6256 ;
    kgx:relTemplate    "citizenship" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?person wdt:P27 ?cty . OPTIONAL { ?cty rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?cty wdt:P18 ?image2 } BIND(?cty AS ?p2)" .

  <urn:kgx:chain:asteroids-composers:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:asteroids-composers:bead:2> ;
    kgx:gloss          "Walk wdt:P30 to the continent of the country" ;
    kgx:produces       wd:Q5107 ;
    kgx:relTemplate    "continent" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?cty wdt:P30 ?cn . OPTIONAL { ?cn rdfs:label ?label3 . FILTER(lang(?label3) = \"en\") } OPTIONAL { ?cn wdt:P18 ?image3 } BIND(?cn AS ?p3)" .

}
