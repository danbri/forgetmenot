@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Asteroids (Q3863) named after (P138) someone whose occupation includes
# composer (Q36834). 'Asteroid 1815 Beethoven', etc.

<urn:kgx:chain:asteroids-composers> {
  <urn:kgx:chain:asteroids-composers>
    dct:title       "Asteroids named after composers" ;
    dct:description "wd:Q3863 (asteroid) where wdt:P138 (named after) holds wdt:P106 = composer." .

  <urn:kgx:chain:asteroids-composers:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Asteroids named after people whose occupation includes composer" ;
    kgx:produces       wd:Q3863 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q3863 ; wdt:P138 ?person . ?person wdt:P106 wd:Q36834 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

