@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:uk-acts-climate> {
  <urn:kgx:chain:uk-acts-climate>
    dct:title       "UK Acts mentioning climate → their subject topics" ;
    dct:description "Two filters: UK Act class membership, English label contains 'climate'. Then pivot via wdt:P921 (main subject) to topics." .

  <urn:kgx:chain:uk-acts-climate:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All instances of UK Act of Parliament (Q4677783)" ;
    kgx:produces       wd:Q4677783 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31/wdt:P279* wd:Q4677783 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:uk-acts-climate:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-acts-climate:bead:0> ;
    kgx:gloss          "English label contains 'climate' (case-insensitive)" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p rdfs:label ?_lbl . FILTER(lang(?_lbl) = \"en\") FILTER(CONTAINS(LCASE(?_lbl), \"climate\"))" .

  <urn:kgx:chain:uk-acts-climate:bead:2> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:uk-acts-climate:bead:1> ;
    kgx:gloss          "Walk wdt:P921 to the main subjects of each Act" ;
    kgx:produces       wd:Q1190554 ;
    kgx:relTemplate    "subjects" ;
    kgx:relVariant     "P921" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P921 ?topic . OPTIONAL { ?topic rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?topic wdt:P18 ?image1 } BIND(?topic AS ?p1)" .

}
