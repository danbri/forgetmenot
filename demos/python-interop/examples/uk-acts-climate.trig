@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Public general Acts of Parliament of the UK (wd:Q4677783) whose
# English label contains 'climate' (case-insensitive). Positive label
# match — keeps the chain endpoint-agnostic.

<urn:kgx:chain:uk-acts-climate> {
  <urn:kgx:chain:uk-acts-climate>
    dct:title       "UK Acts of Parliament mentioning climate" ;
    dct:description "UK Acts whose English label contains the word 'climate' — Climate Change Act 2008 etc." .

  <urn:kgx:chain:uk-acts-climate:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "UK Acts (wd:Q4677783) whose English label contains 'climate'" ;
    kgx:produces       wd:Q4677783 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?act wdt:P31/wdt:P279* wd:Q4677783 . ?act rdfs:label ?label . FILTER(lang(?label) = \"en\") FILTER(CONTAINS(LCASE(?label), \"climate\")) BIND(?act AS ?p) OPTIONAL { ?act wdt:P18 ?image }" .
}

