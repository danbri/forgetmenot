@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:uk-supreme-court> {
  <urn:kgx:chain:uk-supreme-court>
    dct:title       "UK Supreme Court Justices → alma maters → cities → countries" ;
    dct:description "Two atomic beads narrow to Justices of the UK Supreme Court; three pivot beads walk universities → their city → that city's country." .

  <urn:kgx:chain:uk-supreme-court:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All humans" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q5 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:uk-supreme-court:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-supreme-court:bead:0> ;
    kgx:gloss          "Holds Q6317200 (UK SC Justice)" ;
    kgx:propertyIri    wdt:P39 ;
    kgx:valueIri       wd:Q6317200 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P39 wd:Q6317200 ." .

  <urn:kgx:chain:uk-supreme-court:bead:2> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:uk-supreme-court:bead:1> ;
    kgx:gloss          "Walk wdt:P69 to each Justice's universities" ;
    kgx:produces       wd:Q3918 ;
    kgx:relTemplate    "alma_maters" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P69 ?uni . OPTIONAL { ?uni rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?uni wdt:P18 ?image1 } BIND(?uni AS ?p1)" .

  <urn:kgx:chain:uk-supreme-court:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:uk-supreme-court:bead:2> ;
    kgx:gloss          "Walk wdt:P131 to the city the university sits in" ;
    kgx:produces       wd:Q486972 ;
    kgx:relTemplate    "city" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?uni wdt:P131 ?city . ?city wdt:P31/wdt:P279* wd:Q486972 . OPTIONAL { ?city rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?city wdt:P18 ?image2 } BIND(?city AS ?p2)" .

  <urn:kgx:chain:uk-supreme-court:bead:4> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:uk-supreme-court:bead:3> ;
    kgx:gloss          "Walk wdt:P17 to the country of that city" ;
    kgx:produces       wd:Q6256 ;
    kgx:relTemplate    "country" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?city wdt:P17 ?cty . OPTIONAL { ?cty rdfs:label ?label3 . FILTER(lang(?label3) = \"en\") } OPTIONAL { ?cty wdt:P18 ?image3 } BIND(?cty AS ?p3)" .

}
