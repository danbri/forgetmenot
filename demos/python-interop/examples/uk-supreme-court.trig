@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Holders of wd:Q6317200 (Justice of the Supreme Court of the United
# Kingdom). The Court was created in 2009; this returns every justice
# past and present.

<urn:kgx:chain:uk-supreme-court> {
  <urn:kgx:chain:uk-supreme-court>
    dct:title       "Justices of the UK Supreme Court" ;
    dct:description "Everyone who has held the Justice of the Supreme Court of the United Kingdom position." .

  <urn:kgx:chain:uk-supreme-court:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Holders of Q23035001 (Justice of the UK Supreme Court)" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P39 wd:Q6317200 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

