@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:italy-unesco> {
  <urn:kgx:chain:italy-unesco>
    dct:title       "Italian UNESCO sites → regions → regional capitals → other heritage in those capitals" ;
    dct:description "Two filters (UNESCO site class + located in Italy), then pivot through Italian region, the region's capital city, and back to other UNESCO sites in that capital." .

  <urn:kgx:chain:italy-unesco:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All UNESCO World Heritage Sites" ;
    kgx:produces       wd:Q9259 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31/wdt:P279* wd:Q9259 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:italy-unesco:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:italy-unesco:bead:0> ;
    kgx:gloss          "Located in Italy (Q38)" ;
    kgx:propertyIri    wdt:P17 ;
    kgx:valueIri       wd:Q38 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P17 wd:Q38 ." .

  <urn:kgx:chain:italy-unesco:bead:2> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:italy-unesco:bead:1> ;
    kgx:gloss          "Walk wdt:P131+ to the Italian region (regione)" ;
    kgx:produces       wd:Q16110 ;
    kgx:relTemplate    "region" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P131+ ?reg . ?reg wdt:P31 wd:Q16110 . OPTIONAL { ?reg rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?reg wdt:P18 ?image1 } BIND(?reg AS ?p1)" .

  <urn:kgx:chain:italy-unesco:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:italy-unesco:bead:2> ;
    kgx:gloss          "Walk wdt:P36 to the capital of that region" ;
    kgx:produces       wd:Q5119 ;
    kgx:relTemplate    "capital" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?reg wdt:P36 ?cap . OPTIONAL { ?cap rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?cap wdt:P18 ?image2 } BIND(?cap AS ?p2)" .

  <urn:kgx:chain:italy-unesco:bead:4> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:italy-unesco:bead:3> ;
    kgx:gloss          "Inverse wdt:P131+ — other UNESCO sites in that capital" ;
    kgx:produces       wd:Q9259 ;
    kgx:relTemplate    "other_sites" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_other wdt:P131+ ?cap . ?_other wdt:P31/wdt:P279* wd:Q9259 . OPTIONAL { ?_other rdfs:label ?label3 . FILTER(lang(?label3) = \"en\") } OPTIONAL { ?_other wdt:P18 ?image3 } BIND(?_other AS ?p3)" .

}
