@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# UNESCO World Heritage Sites (Q9259) located in Italy (Q38).

<urn:kgx:chain:italy-unesco> {
  <urn:kgx:chain:italy-unesco>
    dct:title       "UNESCO World Heritage sites in Italy" ;
    dct:description "Heritage sites whose country is Italy." .

  <urn:kgx:chain:italy-unesco:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "UNESCO World Heritage Sites in Italy" ;
    kgx:produces       wd:Q9259 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31/wdt:P279* wd:Q9259 ; wdt:P17 wd:Q38 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

