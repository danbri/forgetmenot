@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:nobel-politicians> {
  <urn:kgx:chain:nobel-politicians>
    dct:title       "Recent Nobel laureates who held office → Nobel category → field" ;
    dct:description "Three atomic filters detect post-1950 Nobel laureates who held office; two pivots walk to the specific Nobel award and the field it sits in." .

  <urn:kgx:chain:nobel-politicians:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All humans" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q5 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:nobel-politicians:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:nobel-politicians:bead:0> ;
    kgx:gloss          "Holds a Nobel award (P166 → Q7191 superclass)" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P166 ?_nobel . ?_nobel wdt:P31?/wdt:P279* wd:Q7191 ." .

  <urn:kgx:chain:nobel-politicians:bead:2> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:nobel-politicians:bead:1> ;
    kgx:gloss          "Born on or after 1 January 1950" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P569 ?_dob . FILTER(?_dob >= \"1950-01-01T00:00:00\"^^xsd:dateTime)" .

  <urn:kgx:chain:nobel-politicians:bead:3> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:nobel-politicians:bead:2> ;
    kgx:gloss          "Holds at least one P39 office" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P39 ?_off ." .

  <urn:kgx:chain:nobel-politicians:bead:4> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:nobel-politicians:bead:3> ;
    kgx:gloss          "Walk wdt:P166 to the specific Nobel award won" ;
    kgx:produces       wd:Q7191 ;
    kgx:relTemplate    "nobel" ;
    kgx:relVariant     "award" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P166 ?nob . ?nob wdt:P31?/wdt:P279* wd:Q7191 . OPTIONAL { ?nob rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?nob wdt:P18 ?image1 } BIND(?nob AS ?p1)" .

  <urn:kgx:chain:nobel-politicians:bead:5> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:nobel-politicians:bead:4> ;
    kgx:gloss          "Walk wdt:P361 to the parent prize / field grouping" ;
    kgx:produces       wd:Q11862829 ;
    kgx:relTemplate    "field" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?nob wdt:P361 ?field . OPTIONAL { ?field rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?field wdt:P18 ?image2 } BIND(?field AS ?p2)" .

}
