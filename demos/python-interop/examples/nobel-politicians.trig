@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# People with any Nobel (P166 = Q7191 superclass), who hold any wdt:P39
# (position), and were born since 1950-01-01. Positive age band.

<urn:kgx:chain:nobel-politicians> {
  <urn:kgx:chain:nobel-politicians>
    dct:title       "Nobel laureates born since 1950 who held political office" ;
    dct:description "Nobel Prize winners (any category) born on or after 1950-01-01 who have also held an elected / appointed office." .

  <urn:kgx:chain:nobel-politicians:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Nobel laureates with political office, born 1950 or later" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P166 ?nobel . ?nobel wdt:P31?/wdt:P279* wd:Q7191 . ?p wdt:P39 ?office . ?p wdt:P569 ?dob . FILTER(?dob >= \"1950-01-01T00:00:00\"^^xsd:dateTime) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

