@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:northern-line-tube> {
  <urn:kgx:chain:northern-line-tube>
    dct:title       "Northern-line stations → other lines they serve → other stations on those lines" ;
    dct:description "Three pivots: from Northern-line stations to the other Tube lines they connect with, then to stations on those lines." .

  <urn:kgx:chain:northern-line-tube:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Stations served by the Northern line (Q214793)" ;
    kgx:produces       wd:Q1825098 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P81 wd:Q214793 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:northern-line-tube:bead:1> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:northern-line-tube:bead:0> ;
    kgx:gloss          "Walk wdt:P81 to other lines the station serves" ;
    kgx:produces       wd:Q21878131 ;
    kgx:relTemplate    "interchange" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P81 ?line . FILTER(?line != wd:Q214793) OPTIONAL { ?line rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?line wdt:P18 ?image1 } BIND(?line AS ?p1)" .

  <urn:kgx:chain:northern-line-tube:bead:2> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:northern-line-tube:bead:1> ;
    kgx:gloss          "Inverse wdt:P81 — other stations on those interchange lines" ;
    kgx:produces       wd:Q1825098 ;
    kgx:relTemplate    "other_stations" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?st wdt:P81 ?line . FILTER(?st != ?p) OPTIONAL { ?st rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?st wdt:P18 ?image2 } BIND(?st AS ?p2)" .

}
