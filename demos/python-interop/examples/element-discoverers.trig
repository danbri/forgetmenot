@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:element-discoverers> {
  <urn:kgx:chain:element-discoverers>
    dct:title       "Discoverers of chemical elements → the elements → their groups" ;
    dct:description "Source: people named as P61 (discoverer) of any chemical element; pivots walk to those elements, then their period and group." .

  <urn:kgx:chain:element-discoverers:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "People named as discoverer of any chemical element" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?elem wdt:P31 wd:Q11344 ; wdt:P61 ?p . ?p wdt:P31 wd:Q5 . FILTER(STRSTARTS(STR(?p), \"http://www.wikidata.org/entity/Q\")) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:element-discoverers:bead:1> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:element-discoverers:bead:0> ;
    kgx:gloss          "Inverse-P61 — the elements each person discovered" ;
    kgx:produces       wd:Q11344 ;
    kgx:relTemplate    "elements" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?e wdt:P31 wd:Q11344 ; wdt:P61 ?p . OPTIONAL { ?e rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?e wdt:P18 ?image1 } BIND(?e AS ?p1)" .

  <urn:kgx:chain:element-discoverers:bead:2> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:element-discoverers:bead:1> ;
    kgx:gloss          "Walk wdt:P361 (part of) to the group / family of the element" ;
    kgx:produces       wd:Q21281405 ;
    kgx:relTemplate    "group" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?e wdt:P361 ?grp . OPTIONAL { ?grp rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?grp wdt:P18 ?image2 } BIND(?grp AS ?p2)" .

}
