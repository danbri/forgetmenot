@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# People who discovered or co-discovered any chemical element. The
# element's discoverer (P61) is the inverse axis.

<urn:kgx:chain:element-discoverers> {
  <urn:kgx:chain:element-discoverers>
    dct:title       "Discoverers of chemical elements" ;
    dct:description "People named as the discoverer (P61) of any wd:Q11344 (chemical element)." .

  <urn:kgx:chain:element-discoverers:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "People named as P61 (discoverer) of any chemical element" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?elem wdt:P31 wd:Q11344 ; wdt:P61 ?p . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

