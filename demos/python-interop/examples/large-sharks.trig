@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Mackerel sharks — the family Lamnidae (Q133127). Five extant species
# including great white, mako, salmon. A neat narrow taxonomic angle.

<urn:kgx:chain:large-sharks> {
  <urn:kgx:chain:large-sharks>
    dct:title       "Mackerel sharks (family Lamnidae)" ;
    dct:description "Members of family Lamnidae — great white, makos, salmon shark. Five extant species, all big." .

  <urn:kgx:chain:large-sharks:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Taxa whose parent (P171) is family Lamnidae" ;
    kgx:produces       wd:Q16521 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P171 ?genus . ?genus wdt:P171* wd:Q133127 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}
