@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:large-sharks> {
  <urn:kgx:chain:large-sharks>
    dct:title       "Mackerel sharks (Lamnidae) → their genera" ;
    dct:description "Two atomic beads (parent = Lamnidae + extant species), then pivot to the genus each species sits in." .

  <urn:kgx:chain:large-sharks:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All taxa with parent ≤ family Lamnidae (Q133127)" ;
    kgx:produces       wd:Q16521 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P171 ?_genus . ?_genus wdt:P171* wd:Q133127 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:large-sharks:bead:1> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:large-sharks:bead:0> ;
    kgx:gloss          "Walk wdt:P171 to the genus of each shark species" ;
    kgx:produces       wd:Q34740 ;
    kgx:relTemplate    "genus" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P171 ?gen . OPTIONAL { ?gen rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?gen wdt:P18 ?image1 } BIND(?gen AS ?p1)" .

}
