@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:uk-federation> {
  <urn:kgx:chain:uk-federation>
    dct:title       "UK Labour MPs across Wikidata ↔ Parliament SPARQL" ;
    dct:description "Six atomic Wikidata beads detect 2024-onward Labour MPs, then a single AugmentBundle resolves each Wikidata QID to a Parliament-DDP person + current constituency via rdfs:seeAlso. Two sd:Service endpoints in one chain." .

  <urn:kgx:chain:uk-federation:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All humans" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q5 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:uk-federation:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-federation:bead:0> ;
    kgx:gloss          "Holds at least one P39 position" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?_seat . ?_seat ps:P39 ?_pos ." .

  <urn:kgx:chain:uk-federation:bead:2> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-federation:bead:1> ;
    kgx:gloss          "The held position derives from UK MP class (Q16707842)" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_pos wdt:P279* wd:Q16707842 ." .

  <urn:kgx:chain:uk-federation:bead:3> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-federation:bead:2> ;
    kgx:gloss          "The position's constituency qualifier is in a UK constituency" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_seat pq:P768 ?_cons . ?_cons wdt:P17 wd:Q145 ." .

  <urn:kgx:chain:uk-federation:bead:4> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-federation:bead:3> ;
    kgx:gloss          "Seat's term started on or after the 4 July 2024 GE" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_seat pq:P580 ?_t . FILTER(?_t >= \"2024-07-04T00:00:00\"^^xsd:dateTime)" .

  <urn:kgx:chain:uk-federation:bead:5> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-federation:bead:4> ;
    kgx:gloss          "Party = Labour" ;
    kgx:propertyIri    wdt:P102 ;
    kgx:valueIri       wd:Q9630 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P102 wd:Q9630 ." .

  <urn:kgx:chain:uk-federation:bead:6> a kgx:AugmentBundle ;
    kgx:input          <urn:kgx:chain:uk-federation:bead:5> ;
    kgx:gloss          "Resolve each Wikidata QID to a Parliament person + current constituency" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://api.parliament.uk/sparql> ] ;
    kgx:sparql """PREFIX schema: <https://id.parliament.uk/schema/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wd:   <http://www.wikidata.org/entity/>
SELECT ?qid (SAMPLE(?cgName) AS ?constituency)
            (SAMPLE(?personUri) AS ?parlPerson)
WHERE {
  VALUES ?qid { wd:Q193672 wd:Q4093528 wd:Q1372172 }
  ?personUri rdfs:seeAlso ?qid ;
             a schema:Member ;
             schema:memberHasParliamentaryIncumbency ?in .
  ?in schema:seatIncumbencyHasHouseSeat/schema:houseSeatHasConstituencyGroup/schema:constituencyGroupName ?cgName
} GROUP BY ?qid""" .

}
