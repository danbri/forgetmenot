@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Cross-endpoint federation. Seed from Wikidata (with 2024-onward
# positive temporal anchor), augment from the UK Parliament SPARQL via
# rdfs:seeAlso bridge. Two different sd:Service endpoints in one chain.

<urn:kgx:chain:uk-federation> {
  <urn:kgx:chain:uk-federation>
    dct:title       "UK Labour MP across Wikidata and Parliament's own SPARQL" ;
    dct:description "Seed from Wikidata; augment with current constituency from the Parliament DDP via rdfs:seeAlso." .

  <urn:kgx:chain:uk-federation:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "UK Labour MPs whose Commons seat started on or after 4 July 2024" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?seat . ?seat ps:P39 ?pos . ?pos wdt:P279* wd:Q16707842 . ?seat pq:P768 ?cons . ?cons wdt:P17 wd:Q145 . ?seat pq:P580 ?start . FILTER(?start >= \"2024-07-04T00:00:00\"^^xsd:dateTime) ?p wdt:P102 wd:Q9630 ." .

  <urn:kgx:chain:uk-federation:bead:1> a kgx:AugmentBundle ;
    kgx:input          <urn:kgx:chain:uk-federation:bead:0> ;
    kgx:gloss          "Resolve each Wikidata QID to a Parliament person + current constituency" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://api.parliament.uk/sparql> ] ;
    kgx:sparql """PREFIX schema: <https://id.parliament.uk/schema/>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wd:     <http://www.wikidata.org/entity/>
SELECT ?qid (SAMPLE(?cgName) AS ?constituency)
            (SAMPLE(?personUri) AS ?parlPerson)
WHERE {
  VALUES ?qid { wd:Q193672 wd:Q4093528 wd:Q1372172 }
  ?personUri rdfs:seeAlso ?qid ;
             a schema:Member ;
             schema:memberHasParliamentaryIncumbency ?in .
  ?in schema:seatIncumbencyHasHouseSeat/schema:houseSeatHasConstituencyGroup/schema:constituencyGroupName ?cgName
} GROUP BY ?qid""" .
}

