@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:uk-tory-2024> {
  <urn:kgx:chain:uk-tory-2024>
    dct:title       "UK Conservative MPs since 2024 → universities → cities → countries" ;
    dct:description "Walks five atomic filters to land on Tory MPs sworn in at/after the 2024 GE, then pivots three times: alma maters, the cities those universities sit in, the countries of those cities. Click ▶ Run on any bead to see what the chain means at that step." .

  <urn:kgx:chain:uk-tory-2024:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All humans (wd:Q5)" ;
    kgx:starterId      "humans" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q5 . FILTER(STRSTARTS(STR(?p), \"http://www.wikidata.org/entity/Q\")) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:uk-tory-2024:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-tory-2024:bead:0> ;
    kgx:gloss          "Holds at least one P39 position" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?_seat . ?_seat ps:P39 ?_pos ." .

  <urn:kgx:chain:uk-tory-2024:bead:2> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-tory-2024:bead:1> ;
    kgx:gloss          "The held position derives from UK MP class (Q16707842)" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_pos wdt:P279* wd:Q16707842 ." .

  <urn:kgx:chain:uk-tory-2024:bead:3> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-tory-2024:bead:2> ;
    kgx:gloss          "The position's constituency qualifier is in a UK constituency" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_seat pq:P768 ?_cons . ?_cons wdt:P17 wd:Q145 ." .

  <urn:kgx:chain:uk-tory-2024:bead:4> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-tory-2024:bead:3> ;
    kgx:gloss          "Seat's term started on or after the 4 July 2024 GE" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_seat pq:P580 ?_t . FILTER(?_t >= \"2024-07-04T00:00:00\"^^xsd:dateTime)" .

  <urn:kgx:chain:uk-tory-2024:bead:5> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-tory-2024:bead:4> ;
    kgx:gloss          "Party = Conservative (Q9626)" ;
    kgx:op             "party" ;
    kgx:opValue        "Conservative" ;
    kgx:propertyIri    wdt:P102 ;
    kgx:valueIri       wd:Q9626 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P102 wd:Q9626 ." .

  <urn:kgx:chain:uk-tory-2024:bead:6> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:uk-tory-2024:bead:5> ;
    kgx:gloss          "Walk wdt:P69 to each MP's universities" ;
    kgx:produces       wd:Q3918 ;
    kgx:relTemplate    "alma_maters" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P69 ?uni . ?uni wdt:P31/wdt:P279* wd:Q3918 . OPTIONAL { ?uni rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?uni wdt:P18 ?image1 } BIND(?uni AS ?p1)" .

  <urn:kgx:chain:uk-tory-2024:bead:7> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:uk-tory-2024:bead:6> ;
    kgx:gloss          "Walk wdt:P131 to the city the university sits in" ;
    kgx:produces       wd:Q486972 ;
    kgx:relTemplate    "city_of_university" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?uni wdt:P131 ?city . ?city wdt:P31/wdt:P279* wd:Q486972 . OPTIONAL { ?city rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?city wdt:P18 ?image2 } BIND(?city AS ?p2)" .

  <urn:kgx:chain:uk-tory-2024:bead:8> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:uk-tory-2024:bead:7> ;
    kgx:gloss          "Walk wdt:P17 to the country of that city" ;
    kgx:produces       wd:Q6256 ;
    kgx:relTemplate    "country" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?city wdt:P17 ?cty . OPTIONAL { ?cty rdfs:label ?label3 . FILTER(lang(?label3) = \"en\") } OPTIONAL { ?cty wdt:P18 ?image3 } BIND(?cty AS ?p3)" .

}
