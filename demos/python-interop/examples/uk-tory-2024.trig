@prefix kgx: <urn:kgx:vocab:> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix sd:  <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:  <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .

# UK Conservative MPs who took a Commons seat at or after the 4 July 2024
# general election. Positive temporal anchor on pq:P580 (start date) —
# no FILTER NOT EXISTS / closed-world stuff. The chain shape is the
# everyday FPKG emit: source → party-filter → identity-sanity.

<urn:kgx:chain:uk-tory-2024> {
  <urn:kgx:chain:uk-tory-2024>
    dct:title       "UK Conservative MPs elected since 4 July 2024" ;
    dct:description "About 124 sitting Tory MPs — three filter beads, each runnable on its own." .

  <urn:kgx:chain:uk-tory-2024:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Holders of a UK Commons seat whose term started on or after 4 July 2024" ;
    kgx:starterId      "uk-mps-2024" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?seat . ?seat ps:P39 ?pos . ?pos wdt:P279* wd:Q16707842 . ?seat pq:P768 ?cons . ?cons wdt:P17 wd:Q145 . ?seat pq:P580 ?start . FILTER(?start >= \"2024-07-04T00:00:00\"^^xsd:dateTime) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:uk-tory-2024:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-tory-2024:bead:0> ;
    kgx:gloss          "Members of the Conservative Party" ;
    kgx:op             "party" ;
    kgx:opValue        "Conservative" ;
    kgx:propertyIri    wdt:P102 ;
    kgx:valueIri       wd:Q9626 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P102 wd:Q9626 ." .

  <urn:kgx:chain:uk-tory-2024:bead:2> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-tory-2024:bead:1> ;
    kgx:gloss          "Sanity probe — still wd:Q5 humans" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q5 ." .
}
