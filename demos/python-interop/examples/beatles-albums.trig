@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Albums (wd:Q482994) whose performer is The Beatles (Q1299).

<urn:kgx:chain:beatles-albums> {
  <urn:kgx:chain:beatles-albums>
    dct:title       "Studio albums by The Beatles" ;
    dct:description "wd:Q1299 ← P175 ← any wd:Q482994 (album)." .

  <urn:kgx:chain:beatles-albums:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Albums performed by The Beatles" ;
    kgx:produces       wd:Q482994 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31/wdt:P279* wd:Q482994 ; wdt:P175 wd:Q1299 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

