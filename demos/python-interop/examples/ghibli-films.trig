@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Films (Q11424) produced by Studio Ghibli (Q174870).

<urn:kgx:chain:ghibli-films> {
  <urn:kgx:chain:ghibli-films>
    dct:title       "Studio Ghibli feature films" ;
    dct:description "Films whose production company is Studio Ghibli." .

  <urn:kgx:chain:ghibli-films:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Films produced by Studio Ghibli" ;
    kgx:produces       wd:Q11424 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31/wdt:P279* wd:Q11424 ; wdt:P272 wd:Q182950 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

