@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .

@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# UK Labour MPs whose Commons seat started on or after 4 July 2024.
# Three filter beads compile into ONE fused query against
# qlever.dev/api/wikidata. The Execution record names which beads it
# fuses; an inspector can replay it without re-fusing.

<urn:kgx:chain:uk-labour-2024> {
  <urn:kgx:chain:uk-labour-2024>
    dct:title       "UK Labour MPs elected since 4 July 2024 (fused execution)" ;
    dct:description "Three filter beads compiled into one SPARQL — about 400 sitting Labour MPs with portraits where Wikidata has them." ;
    dct:created     "2026-06-12T08:00:00Z"^^xsd:dateTime .

  <urn:kgx:chain:uk-labour-2024:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "UK Commons seats whose term started on or after 4 July 2024" ;
    kgx:starterId      "uk-mps-2024" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?seat . ?seat ps:P39 ?pos . ?pos wdt:P279* wd:Q16707842 . ?seat pq:P768 ?cons . ?cons wdt:P17 wd:Q145 . ?seat pq:P580 ?start . FILTER(?start >= \"2024-07-04T00:00:00\"^^xsd:dateTime) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" ;
    kgx:executedBy     <urn:kgx:chain:uk-labour-2024:exec:0> .

  <urn:kgx:chain:uk-labour-2024:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-labour-2024:bead:0> ;
    kgx:gloss          "Members of the Labour Party (Q9630)" ;
    kgx:propertyIri    wdt:P102 ;
    kgx:valueIri       wd:Q9630 ;
    kgx:sparqlFragment "?p wdt:P102 wd:Q9630 ." ;
    kgx:executedBy     <urn:kgx:chain:uk-labour-2024:exec:0> .

  <urn:kgx:chain:uk-labour-2024:bead:2> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-labour-2024:bead:1> ;
    kgx:gloss          "Sanity probe — wd:Q5 humans" ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q5 ." ;
    kgx:executedBy     <urn:kgx:chain:uk-labour-2024:exec:0> .

  <urn:kgx:chain:uk-labour-2024:exec:0> a kgx:Execution ;
    kgx:against [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:fusedSparql """PREFIX wd:   <http://www.wikidata.org/entity/>
PREFIX wdt:  <http://www.wikidata.org/prop/direct/>
PREFIX p:    <http://www.wikidata.org/prop/>
PREFIX ps:   <http://www.wikidata.org/prop/statement/>
PREFIX pq:   <http://www.wikidata.org/prop/qualifier/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?p ?label ?image WHERE {
  ?p p:P39 ?seat .
  ?seat ps:P39 ?pos . ?pos wdt:P279* wd:Q16707842 .
  ?seat pq:P768 ?cons . ?cons wdt:P17 wd:Q145 .
  ?seat pq:P580 ?start . FILTER(?start >= "2024-07-04T00:00:00"^^xsd:dateTime)
  ?p wdt:P102 wd:Q9630 .
  OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = "en") }
  OPTIONAL { ?p wdt:P18 ?image }
}""" ;
    kgx:fuses ( <urn:kgx:chain:uk-labour-2024:bead:0>
                <urn:kgx:chain:uk-labour-2024:bead:1>
                <urn:kgx:chain:uk-labour-2024:bead:2> ) .
}

