@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Operas (Q1344 subclass) composed by Mozart (Q254).

<urn:kgx:chain:mozart-operas> {
  <urn:kgx:chain:mozart-operas>
    dct:title       "Operas by Wolfgang Amadeus Mozart" ;
    dct:description "wd:Q254 (Mozart) ← P86 ← any wd:Q1344 (opera)." .

  <urn:kgx:chain:mozart-operas:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Operas composed by Mozart" ;
    kgx:produces       wd:Q1344 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P86 wd:Q254 ; wdt:P136 wd:Q1344 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

