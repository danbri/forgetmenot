@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:mozart-operas> {
  <urn:kgx:chain:mozart-operas>
    dct:title       "Mozart → his works → operas → librettists → countries" ;
    dct:description "Source: Mozart himself. Pivot to his compositions, filter to operas (P136=Q1344), pivot to librettists, then to their countries." .

  <urn:kgx:chain:mozart-operas:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Wolfgang Amadeus Mozart" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "VALUES ?p { wd:Q254 } OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:mozart-operas:bead:1> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:mozart-operas:bead:0> ;
    kgx:gloss          "Inverse wdt:P86 — works he composed" ;
    kgx:produces       wd:Q2188189 ;
    kgx:relTemplate    "compositions" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_w wdt:P86 ?p . OPTIONAL { ?_w rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?_w wdt:P18 ?image1 } BIND(?_w AS ?p1)" .

  <urn:kgx:chain:mozart-operas:bead:2> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:mozart-operas:bead:1> ;
    kgx:gloss          "Genre = opera (Q1344)" ;
    kgx:propertyIri    wdt:P136 ;
    kgx:valueIri       wd:Q1344 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p1 wdt:P136 wd:Q1344 ." .

  <urn:kgx:chain:mozart-operas:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:mozart-operas:bead:2> ;
    kgx:gloss          "Walk wdt:P87 to the librettist of each opera" ;
    kgx:produces       wd:Q5 ;
    kgx:relTemplate    "librettist" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p1 wdt:P87 ?lib . OPTIONAL { ?lib rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?lib wdt:P18 ?image2 } BIND(?lib AS ?p2)" .

  <urn:kgx:chain:mozart-operas:bead:4> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:mozart-operas:bead:3> ;
    kgx:gloss          "Walk wdt:P27 to country of citizenship" ;
    kgx:produces       wd:Q6256 ;
    kgx:relTemplate    "country" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?lib wdt:P27 ?cty . OPTIONAL { ?cty rdfs:label ?label3 . FILTER(lang(?label3) = \"en\") } OPTIONAL { ?cty wdt:P18 ?image3 } BIND(?cty AS ?p3)" .

}
