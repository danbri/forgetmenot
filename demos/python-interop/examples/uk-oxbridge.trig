@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Two filter chains merged via kgx:UnionBundle: Oxford alumni
# (P69 = wd:Q34433) ∪ Cambridge alumni (P69 = wd:Q35794) among MPs whose
# Commons seat started on or after 4 July 2024.

<urn:kgx:chain:uk-oxbridge> {
  <urn:kgx:chain:uk-oxbridge>
    dct:title       "UK MPs who studied at Oxford or Cambridge (since 2024)" ;
    dct:description "Two parallel filter chains, deduped on identity. Either branch alone misses the other." .

  <urn:kgx:chain:uk-oxbridge:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "UK Commons seats whose term started on or after 4 July 2024" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?seat . ?seat ps:P39 ?pos . ?pos wdt:P279* wd:Q16707842 . ?seat pq:P768 ?cons . ?cons wdt:P17 wd:Q145 . ?seat pq:P580 ?start . FILTER(?start >= \"2024-07-04T00:00:00\"^^xsd:dateTime) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:uk-oxbridge:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-oxbridge:bead:0> ;
    kgx:gloss          "Educated at the University of Oxford (Q34433)" ;
    kgx:propertyIri    wdt:P69 ;
    kgx:valueIri       wd:Q34433 ;
    kgx:sparqlFragment "?p wdt:P69 wd:Q34433 ." .

  <urn:kgx:chain:uk-oxbridge:bead:2> a kgx:SourceBundle ;
    kgx:gloss          "UK Commons seats whose term started on or after 4 July 2024" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?seat . ?seat ps:P39 ?pos . ?pos wdt:P279* wd:Q16707842 . ?seat pq:P768 ?cons . ?cons wdt:P17 wd:Q145 . ?seat pq:P580 ?start . FILTER(?start >= \"2024-07-04T00:00:00\"^^xsd:dateTime) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:uk-oxbridge:bead:3> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-oxbridge:bead:2> ;
    kgx:gloss          "Educated at the University of Cambridge (Q35794)" ;
    kgx:propertyIri    wdt:P69 ;
    kgx:valueIri       wd:Q35794 ;
    kgx:sparqlFragment "?p wdt:P69 wd:Q35794 ." .

  <urn:kgx:chain:uk-oxbridge:bead:4> a kgx:UnionBundle ;
    kgx:gloss "Oxford alumni ∪ Cambridge alumni — items in either, deduped on ?p" ;
    kgx:inputs ( <urn:kgx:chain:uk-oxbridge:bead:1>
                 <urn:kgx:chain:uk-oxbridge:bead:3> ) .
}

