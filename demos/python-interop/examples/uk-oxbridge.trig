@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .

<urn:kgx:chain:uk-oxbridge> {
  <urn:kgx:chain:uk-oxbridge>
    dct:title       "UK MPs at Oxford ∪ Cambridge → their fields of study" ;
    dct:description "Two parallel branches detect 2024-cohort MPs with P69=Oxford and P69=Cambridge respectively, merged via kgx:UnionBundle, then a downstream pivot walks wdt:P101 (field of work) to surface what they studied." .

  # ---- Left branch: Oxford alumni ----
  <urn:kgx:chain:uk-oxbridge:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All humans (left branch)" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q5 . FILTER(STRSTARTS(STR(?p), \"http://www.wikidata.org/entity/Q\")) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:uk-oxbridge:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-oxbridge:bead:0> ;
    kgx:gloss          "Holds at least one P39 position" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?_seat . ?_seat ps:P39 ?_pos ." .

  <urn:kgx:chain:uk-oxbridge:bead:2> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-oxbridge:bead:1> ;
    kgx:gloss          "Position derives from UK MP class (Q16707842)" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_pos wdt:P279* wd:Q16707842 ." .

  <urn:kgx:chain:uk-oxbridge:bead:3> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-oxbridge:bead:2> ;
    kgx:gloss          "Seat's constituency qualifier is in a UK constituency" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_seat pq:P768 ?_cons . ?_cons wdt:P17 wd:Q145 ." .

  <urn:kgx:chain:uk-oxbridge:bead:4> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-oxbridge:bead:3> ;
    kgx:gloss          "Seat started on or after 4 July 2024" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_seat pq:P580 ?_t . FILTER(?_t >= \"2024-07-04T00:00:00\"^^xsd:dateTime)" .

  <urn:kgx:chain:uk-oxbridge:bead:5> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-oxbridge:bead:4> ;
    kgx:gloss          "Educated at the University of Oxford (Q34433)" ;
    kgx:propertyIri    wdt:P69 ;
    kgx:valueIri       wd:Q34433 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P69 wd:Q34433 ." .

  # ---- Right branch: Cambridge alumni ----
  <urn:kgx:chain:uk-oxbridge:bead:6> a kgx:SourceBundle ;
    kgx:gloss          "All humans (right branch)" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q5 . FILTER(STRSTARTS(STR(?p), \"http://www.wikidata.org/entity/Q\")) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:uk-oxbridge:bead:7> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-oxbridge:bead:6> ;
    kgx:gloss          "Holds at least one P39 position" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?_seat . ?_seat ps:P39 ?_pos ." .

  <urn:kgx:chain:uk-oxbridge:bead:8> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-oxbridge:bead:7> ;
    kgx:gloss          "Position derives from UK MP class" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_pos wdt:P279* wd:Q16707842 ." .

  <urn:kgx:chain:uk-oxbridge:bead:9> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-oxbridge:bead:8> ;
    kgx:gloss          "Seat's qualifier is a UK constituency" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_seat pq:P768 ?_cons . ?_cons wdt:P17 wd:Q145 ." .

  <urn:kgx:chain:uk-oxbridge:bead:10> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-oxbridge:bead:9> ;
    kgx:gloss          "Seat started on or after 4 July 2024" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_seat pq:P580 ?_t . FILTER(?_t >= \"2024-07-04T00:00:00\"^^xsd:dateTime)" .

  <urn:kgx:chain:uk-oxbridge:bead:11> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-oxbridge:bead:10> ;
    kgx:gloss          "Educated at the University of Cambridge (Q35794)" ;
    kgx:propertyIri    wdt:P69 ;
    kgx:valueIri       wd:Q35794 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P69 wd:Q35794 ." .

  # ---- Union the two branches ----
  <urn:kgx:chain:uk-oxbridge:bead:12> a kgx:UnionBundle ;
    kgx:gloss "Oxford alumni ∪ Cambridge alumni — items in either, deduped on ?p" ;
    kgx:inputs ( <urn:kgx:chain:uk-oxbridge:bead:5>
                 <urn:kgx:chain:uk-oxbridge:bead:11> ) .

  # ---- Pivot downstream of the union ----
  <urn:kgx:chain:uk-oxbridge:bead:13> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:uk-oxbridge:bead:12> ;
    kgx:gloss          "Walk wdt:P101 from each MP to their field of work / study" ;
    kgx:produces       wd:Q11862829 ;
    kgx:relTemplate    "field_of_study" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P101 ?fld . OPTIONAL { ?fld rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?fld wdt:P18 ?image1 } BIND(?fld AS ?p1)" .
}
