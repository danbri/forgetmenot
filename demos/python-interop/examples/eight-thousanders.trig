@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:eight-thousanders> {
  <urn:kgx:chain:eight-thousanders>
    dct:title       "Mountains > 8 000 m → countries → continents" ;
    dct:description "Two filter beads (mountain class + elevation ≥ 8000 m), then pivot to country and continent." .

  <urn:kgx:chain:eight-thousanders:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All mountains (Q8502 subclass)" ;
    kgx:produces       wd:Q8502 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31/wdt:P279* wd:Q8502 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:eight-thousanders:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:eight-thousanders:bead:0> ;
    kgx:gloss          "Elevation above sea level ≥ 8 000 m" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P2044 ?_elev . FILTER(?_elev >= 8000)" .

  <urn:kgx:chain:eight-thousanders:bead:2> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:eight-thousanders:bead:1> ;
    kgx:gloss          "Walk wdt:P17 to the country of the peak" ;
    kgx:produces       wd:Q6256 ;
    kgx:relTemplate    "country" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P17 ?cty . OPTIONAL { ?cty rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?cty wdt:P18 ?image1 } BIND(?cty AS ?p1)" .

  <urn:kgx:chain:eight-thousanders:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:eight-thousanders:bead:2> ;
    kgx:gloss          "Walk wdt:P30 to the continent" ;
    kgx:produces       wd:Q5107 ;
    kgx:relTemplate    "continent" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?cty wdt:P30 ?cn . OPTIONAL { ?cn rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?cn wdt:P18 ?image2 } BIND(?cn AS ?p2)" .

}
