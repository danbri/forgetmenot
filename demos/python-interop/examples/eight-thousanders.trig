@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Mountains (Q8502) at least 8 000 m high — the fourteen Eight-Thousanders
# (a few extra returned because Wikidata distinguishes summits / subsidiaries).

<urn:kgx:chain:eight-thousanders> {
  <urn:kgx:chain:eight-thousanders>
    dct:title       "Mountains above 8 000 m" ;
    dct:description "wd:Q8502 (mountain) with wdt:P2044 (elevation above sea level) ≥ 8000 metres." .

  <urn:kgx:chain:eight-thousanders:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Mountains with elevation above sea level ≥ 8000 m" ;
    kgx:produces       wd:Q8502 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31/wdt:P279* wd:Q8502 . ?p wdt:P2044 ?elev . FILTER(?elev >= 8000) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

