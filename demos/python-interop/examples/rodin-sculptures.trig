@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Sculptures (Q860861 subclass) created by Rodin (Q30755).

<urn:kgx:chain:rodin-sculptures> {
  <urn:kgx:chain:rodin-sculptures>
    dct:title       "Sculptures by Auguste Rodin" ;
    dct:description "wd:Q30755 (Rodin) ← P170 ← any wd:Q860861 (sculpture)." .

  <urn:kgx:chain:rodin-sculptures:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Sculptures created by Auguste Rodin" ;
    kgx:produces       wd:Q860861 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31/wdt:P279* wd:Q860861 ; wdt:P170 wd:Q30755 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

