@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:van-gogh-paintings> {
  <urn:kgx:chain:van-gogh-paintings>
    dct:title       "Van Gogh → his paintings → museums → cities → countries" ;
    dct:description "Source: Van Gogh. Inverse-P170 to paintings, filter to painting class, pivot to housing museum, then to that museum's city and country." .

  <urn:kgx:chain:van-gogh-paintings:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Vincent van Gogh" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "VALUES ?p { wd:Q5582 } OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:van-gogh-paintings:bead:1> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:van-gogh-paintings:bead:0> ;
    kgx:gloss          "Inverse wdt:P170 — works he created" ;
    kgx:produces       wd:Q838948 ;
    kgx:relTemplate    "works" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_w wdt:P170 ?p . OPTIONAL { ?_w rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?_w wdt:P18 ?image1 } BIND(?_w AS ?p1)" .

  <urn:kgx:chain:van-gogh-paintings:bead:2> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:van-gogh-paintings:bead:1> ;
    kgx:gloss          "Is a painting (Q3305213)" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p1 wdt:P31/wdt:P279* wd:Q3305213 ." .

  <urn:kgx:chain:van-gogh-paintings:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:van-gogh-paintings:bead:2> ;
    kgx:gloss          "Walk wdt:P276 to housing institution" ;
    kgx:produces       wd:Q33506 ;
    kgx:relTemplate    "collection" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p1 wdt:P276 ?mus . OPTIONAL { ?mus rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?mus wdt:P18 ?image2 } BIND(?mus AS ?p2)" .

  <urn:kgx:chain:van-gogh-paintings:bead:4> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:van-gogh-paintings:bead:3> ;
    kgx:gloss          "Walk wdt:P131 to the city the museum sits in" ;
    kgx:produces       wd:Q486972 ;
    kgx:relTemplate    "city" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?mus wdt:P131 ?city . ?city wdt:P31/wdt:P279* wd:Q486972 . OPTIONAL { ?city rdfs:label ?label3 . FILTER(lang(?label3) = \"en\") } OPTIONAL { ?city wdt:P18 ?image3 } BIND(?city AS ?p3)" .

  <urn:kgx:chain:van-gogh-paintings:bead:5> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:van-gogh-paintings:bead:4> ;
    kgx:gloss          "Walk wdt:P17 to the country" ;
    kgx:produces       wd:Q6256 ;
    kgx:relTemplate    "country" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?city wdt:P17 ?cty . OPTIONAL { ?cty rdfs:label ?label4 . FILTER(lang(?label4) = \"en\") } OPTIONAL { ?cty wdt:P18 ?image4 } BIND(?cty AS ?p4)" .

}
