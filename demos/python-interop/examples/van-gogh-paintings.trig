@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Paintings (Q3305213 subclass) created by Van Gogh (Q5582).

<urn:kgx:chain:van-gogh-paintings> {
  <urn:kgx:chain:van-gogh-paintings>
    dct:title       "Paintings by Vincent van Gogh" ;
    dct:description "wd:Q5582 (Van Gogh) ← P170 ← any wd:Q3305213 (painting)." .

  <urn:kgx:chain:van-gogh-paintings:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Paintings created by Vincent van Gogh" ;
    kgx:produces       wd:Q3305213 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31/wdt:P279* wd:Q3305213 ; wdt:P170 wd:Q5582 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

