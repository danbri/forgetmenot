@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Positive Intersection: anyone holding a minister-class role (Q83307)
# AND a current Lords seat (Q18941264). Replaces the previous Difference
# example — both predicates are positive presence assertions.

<urn:kgx:chain:cabinet-in-lords> {
  <urn:kgx:chain:cabinet-in-lords>
    dct:title       "UK Cabinet ministers who sit in the House of Lords" ;
    dct:description "Intersection of two positive filters — holds a minister role AND a Lords seat." .

  <urn:kgx:chain:cabinet-in-lords:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "People holding any minister-class role (Q83307)" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P39 ?r . ?r wdt:P279* wd:Q83307 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:cabinet-in-lords:bead:1> a kgx:SourceBundle ;
    kgx:gloss          "Members of the UK House of Lords" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P39 ?seat . ?seat wdt:P279* wd:Q18941264 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:cabinet-in-lords:bead:2> a kgx:IntersectBundle ;
    kgx:gloss "Minister role ∩ Lords seat — items present in both inputs" ;
    kgx:inputs ( <urn:kgx:chain:cabinet-in-lords:bead:0>
                 <urn:kgx:chain:cabinet-in-lords:bead:1> ) .
}

