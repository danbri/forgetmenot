@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# "MPs elected since 2000" is ambiguous. The bead records THREE concrete
# variants and pins kgx:activeVariant to the one the interpreter chose
# this run. Unchosen variants survive in the manifest so a consumer can
# replay or fall back without re-deriving the alternatives. All three
# variants are POSITIVE temporal filters (no NOT EXISTS).

<urn:kgx:chain:uk-since-2000-variants> {
  <urn:kgx:chain:uk-since-2000-variants>
    dct:title "MPs elected since 2000 — three readings recorded in the manifest" ;
    dct:description "The 'since 2000' filter has three plausible groundings; the manifest records all three and which one ran." .

  <urn:kgx:chain:uk-since-2000-variants:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Holders of a Member-of-Parliament seat" ;
    kgx:starterId      "uk-mps-1900" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?seat . ?seat ps:P39 ?pos . ?pos wdt:P279* wd:Q16707842 . ?seat pq:P768 ?cons . ?cons wdt:P17 wd:Q145 ." .

  <urn:kgx:chain:uk-since-2000-variants:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-since-2000-variants:bead:0> ;
    kgx:gloss          "Recent MPs — but how 'recent'?" ;
    kgx:op             "since" ;
    kgx:opValue        "2000" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:variants (
      [ kgx:label "born in or after 2000"   ;
        kgx:sparqlFragment "?p wdt:P569 ?dob . FILTER(YEAR(?dob) >= 2000)" ]
      [ kgx:label "first elected ≥ 2000 (any seat)"   ;
        kgx:sparqlFragment "?p p:P39 [ pq:P580 ?start ] . FILTER(YEAR(?start) >= 2000)" ]
      [ kgx:label "in an MP-of-UK seat that began ≥ 2000"   ;
        kgx:sparqlFragment "?p p:P39 ?s . ?s ps:P39 ?pos . ?pos wdt:P279* wd:Q16707842 . ?s pq:P768 ?c . ?c wdt:P17 wd:Q145 . ?s pq:P580 ?start . FILTER(YEAR(?start) >= 2000)" ]
    ) ;
    kgx:activeVariant 2 .
}

