@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:uk-since-2000-variants> {
  <urn:kgx:chain:uk-since-2000-variants>
    dct:title       "UK MPs since 2000 — three readings recorded" ;
    dct:description "'Since 2000' is genuinely ambiguous. The Filter bead records all THREE positive-shape groundings as kgx:variants; the chosen one is pinned via kgx:activeVariant. No NOT EXISTS in any variant." .

  <urn:kgx:chain:uk-since-2000-variants:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All humans" ;
    kgx:starterId      "humans" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q5 . FILTER(STRSTARTS(STR(?p), \"http://www.wikidata.org/entity/Q\")) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:uk-since-2000-variants:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-since-2000-variants:bead:0> ;
    kgx:gloss          "Holds an MP-of-UK seat" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?seat . ?seat ps:P39 ?pos . ?pos wdt:P279* wd:Q16707842 . ?seat pq:P768 ?cons . ?cons wdt:P17 wd:Q145 ." .

  <urn:kgx:chain:uk-since-2000-variants:bead:2> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:uk-since-2000-variants:bead:1> ;
    kgx:gloss          "Recent — but how 'recent'?" ;
    kgx:op             "since" ;
    kgx:opValue        "2000" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:variants (
      [ kgx:label "born in or after 2000" ;
        kgx:sparqlFragment "?p wdt:P569 ?dob . FILTER(YEAR(?dob) >= 2000)" ]
      [ kgx:label "first elected ≥ 2000 (any seat)" ;
        kgx:sparqlFragment "?p p:P39 [ pq:P580 ?start ] . FILTER(YEAR(?start) >= 2000)" ]
      [ kgx:label "in an MP-of-UK seat that began ≥ 2000" ;
        kgx:sparqlFragment "?p p:P39 ?s . ?s ps:P39 ?pos . ?pos wdt:P279* wd:Q16707842 . ?s pq:P768 ?c . ?c wdt:P17 wd:Q145 . ?s pq:P580 ?start . FILTER(YEAR(?start) >= 2000)" ]
    ) ;
    kgx:activeVariant 2 .

}
