@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# MEPs whose European Parliament seat (wd:Q27169) started on or after the
# 2024 EP election (6-9 June 2024). The 10th term runs to 2029.

<urn:kgx:chain:meps-current> {
  <urn:kgx:chain:meps-current>
    dct:title       "MEPs of the current European Parliament term" ;
    dct:description "Members of the European Parliament whose seat started on or after the 2024 election." .

  <urn:kgx:chain:meps-current:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "European Parliament seats whose term started on or after 16 July 2024 (the 10th EP's first sitting)" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?seat . ?seat ps:P39 wd:Q27169 . ?seat pq:P580 ?start . FILTER(?start >= \"2024-07-16T00:00:00\"^^xsd:dateTime) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

