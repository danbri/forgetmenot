@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:meps-current> {
  <urn:kgx:chain:meps-current>
    dct:title       "Current MEPs → national parties → countries → continents" ;
    dct:description "Three atomic filters detect current-term EP seats, then pivot through MEP → national party → country → continent." .

  <urn:kgx:chain:meps-current:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All humans" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q5 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:meps-current:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:meps-current:bead:0> ;
    kgx:gloss          "Holds a P39 position" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p p:P39 ?_seat . ?_seat ps:P39 ?_pos ." .

  <urn:kgx:chain:meps-current:bead:2> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:meps-current:bead:1> ;
    kgx:gloss          "Position is Member of the European Parliament (Q27169)" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_pos wdt:P279* wd:Q27169 ." .

  <urn:kgx:chain:meps-current:bead:3> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:meps-current:bead:2> ;
    kgx:gloss          "Seat started ≥ 16 July 2024 (10th EP)" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?_seat pq:P580 ?_t . FILTER(?_t >= \"2024-07-16T00:00:00\"^^xsd:dateTime)" .

  <urn:kgx:chain:meps-current:bead:4> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:meps-current:bead:3> ;
    kgx:gloss          "Walk wdt:P102 to each MEP's national party" ;
    kgx:produces       wd:Q7278 ;
    kgx:relTemplate    "party" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P102 ?party . OPTIONAL { ?party rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?party wdt:P18 ?image1 } BIND(?party AS ?p1)" .

  <urn:kgx:chain:meps-current:bead:5> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:meps-current:bead:4> ;
    kgx:gloss          "Walk wdt:P17 to the country of that party" ;
    kgx:produces       wd:Q6256 ;
    kgx:relTemplate    "country" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?party wdt:P17 ?cty . OPTIONAL { ?cty rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?cty wdt:P18 ?image2 } BIND(?cty AS ?p2)" .

  <urn:kgx:chain:meps-current:bead:6> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:meps-current:bead:5> ;
    kgx:gloss          "Walk wdt:P30 to the continent of that country" ;
    kgx:produces       wd:Q5107 ;
    kgx:relTemplate    "continent" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?cty wdt:P30 ?cn . OPTIONAL { ?cn rdfs:label ?label3 . FILTER(lang(?label3) = \"en\") } OPTIONAL { ?cn wdt:P18 ?image3 } BIND(?cn AS ?p3)" .

}
