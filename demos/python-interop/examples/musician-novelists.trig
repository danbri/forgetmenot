@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# People whose occupation list includes both musician and writer, with
# at least one authored work that's a book.

<urn:kgx:chain:musician-novelists> {
  <urn:kgx:chain:musician-novelists>
    dct:title       "Musicians who also publish novels" ;
    dct:description "Intersection of P106 = musician AND P106 = writer, with at least one P50 (author of) → wd:Q571 (book)." .

  <urn:kgx:chain:musician-novelists:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "People who are both musicians and writers, with a book authored" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P106 wd:Q639669 ; wdt:P106 wd:Q36180 . ?book wdt:P50 ?p ; wdt:P31/wdt:P279* wd:Q571 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

