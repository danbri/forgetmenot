@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .


# Members of the House of Tudor (Q102078) who held a monarch position.

<urn:kgx:chain:tudor-monarchs> {
  <urn:kgx:chain:tudor-monarchs>
    dct:title       "British monarchs of the House of Tudor" ;
    dct:description "Members of wd:Q101978 (House of Tudor) who held a monarch-class position." .

  <urn:kgx:chain:tudor-monarchs:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "Tudor-house members with a monarch role" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P53 wd:Q101978 . ?p wdt:P39 ?off . ?off wdt:P279* wd:Q116 . OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .
}

