@prefix kgx:  <urn:kgx:vocab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sd:   <http://www.w3.org/ns/sparql-service-description#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix wdt:  <http://www.wikidata.org/prop/direct/> .



<urn:kgx:chain:tudor-monarchs> {
  <urn:kgx:chain:tudor-monarchs>
    dct:title       "Tudor monarchs → spouses → children → grandchildren" ;
    dct:description "One filter detects Tudor-house monarchs; three pivots walk through spouse (P26), child (P40), and grandchild (P40 of P40)." .

  <urn:kgx:chain:tudor-monarchs:bead:0> a kgx:SourceBundle ;
    kgx:gloss          "All humans" ;
    kgx:produces       wd:Q5 ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P31 wd:Q5 . FILTER(STRSTARTS(STR(?p), \"http://www.wikidata.org/entity/Q\")) OPTIONAL { ?p rdfs:label ?label . FILTER(lang(?label) = \"en\") } OPTIONAL { ?p wdt:P18 ?image }" .

  <urn:kgx:chain:tudor-monarchs:bead:1> a kgx:FilterBundle ;
    kgx:input          <urn:kgx:chain:tudor-monarchs:bead:0> ;
    kgx:gloss          "House of Tudor membership (Q101978)" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P53 wd:Q101978 . ?p wdt:P39 ?_off . ?_off wdt:P279* wd:Q116 ." .

  <urn:kgx:chain:tudor-monarchs:bead:2> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:tudor-monarchs:bead:1> ;
    kgx:gloss          "Walk wdt:P26 to their spouse(s)" ;
    kgx:produces       wd:Q5 ;
    kgx:relTemplate    "spouse" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?p wdt:P26 ?sp . OPTIONAL { ?sp rdfs:label ?label1 . FILTER(lang(?label1) = \"en\") } OPTIONAL { ?sp wdt:P18 ?image1 } BIND(?sp AS ?p1)" .

  <urn:kgx:chain:tudor-monarchs:bead:3> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:tudor-monarchs:bead:2> ;
    kgx:gloss          "Walk wdt:P40 to their children" ;
    kgx:produces       wd:Q5 ;
    kgx:relTemplate    "child" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?sp wdt:P40 ?child . OPTIONAL { ?child rdfs:label ?label2 . FILTER(lang(?label2) = \"en\") } OPTIONAL { ?child wdt:P18 ?image2 } BIND(?child AS ?p2)" .

  <urn:kgx:chain:tudor-monarchs:bead:4> a kgx:PivotBundle ;
    kgx:input          <urn:kgx:chain:tudor-monarchs:bead:3> ;
    kgx:gloss          "Walk wdt:P40 to grandchildren" ;
    kgx:produces       wd:Q5 ;
    kgx:relTemplate    "grandchild" ;
    kgx:relVariant     "default" ;
    kgx:queryAgainst   [ a sd:Service ; sd:endpoint <https://qlever.dev/api/wikidata> ] ;
    kgx:sparqlFragment "?child wdt:P40 ?gc . OPTIONAL { ?gc rdfs:label ?label3 . FILTER(lang(?label3) = \"en\") } OPTIONAL { ?gc wdt:P18 ?image3 } BIND(?gc AS ?p3)" .

}
